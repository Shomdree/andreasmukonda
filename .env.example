# URL publique du site (sans slash final) — PUBLIC
PUBLIC_SITE_URL=http://localhost:4321

# --- Supabase PUBLIC (exposées au navigateur, protégées par RLS) ---
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase SECRET (serveur uniquement, jamais PUBLIC_) ---
# Obligatoire en production pour Contact, Commande, RPC et Storage.
# Ne jamais préfixer PUBLIC_ : la clé serait alors envoyée au navigateur.
SUPABASE_SERVICE_ROLE_KEY=

# Email du premier administrateur (allowlist optionnelle, en plus de profiles.role = admin)
ADMIN_EMAIL=

# WhatsApp principal optionnel (sinon Admin → Paramètres / defaults.ts)
# Format chiffres internationaux : 243841197130 — PUBLIC
PUBLIC_WHATSAPP_NUMBER=

# Notification email (Resend) — SECRET
# Sans EMAIL_PROVIDER_API_KEY, les formulaires sont enregistrés mais aucun email
# n'est envoyé. Compte gratuit : https://resend.com → API Keys (re_...).
# Destination : ADMIN_EMAIL (sinon l'email du site). Sans domaine vérifié,
# EMAIL_FROM peut rester vide (expéditeur Resend par défaut, uniquement vers
# l'email du compte Resend).
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=

# Analytics léger optionnel (Plausible / Umami) — PUBLIC
PUBLIC_ANALYTICS_SRC=
PUBLIC_ANALYTICS_DOMAIN=
