---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import ConsultationForm from "../components/ConsultationForm.astro";
import ProcessSteps from "../components/ProcessSteps.astro";
import Portrait from "../components/Portrait.astro";
import { pageI18n } from "../i18n/request";
import { submitConsultation } from "../lib/actions";
import { getSettings } from "../lib/queries";

const { t, href } = pageI18n(Astro.locals);
const settings = await getSettings();
let errors: Record<string, string> | undefined;
let values: Record<string, string> | undefined;
let sent = Astro.url.searchParams.get("ok") === "1";

if (Astro.request.method === "POST") {
  const result = await submitConsultation(Astro.request, await Astro.request.formData());
  if (result.ok) return Astro.redirect(`${href("/consulting")}?ok=1`);
  errors = result.errors;
  values = result.values;
}

const steps = [
  { title: t.consultingPage.step1Title, text: t.consultingPage.step1 },
  { title: t.consultingPage.step2Title, text: t.consultingPage.step2 },
  { title: t.consultingPage.step3Title, text: t.consultingPage.step3 },
];
const needs = [
  { title: t.consultingPage.needStart, text: t.consultingPage.needStartText },
  { title: t.consultingPage.needPresent, text: t.consultingPage.needPresentText },
  { title: t.consultingPage.needOrganize, text: t.consultingPage.needOrganizeText },
];
const showPortrait = Boolean(settings.portrait) && !settings.portrait.includes("placeholder");
---

<BaseLayout
  settings={settings}
  title={t.seo.consultingTitle}
  description={t.seo.consultingDescription}
  canonicalPath="/consulting"
>
  <section class="section consult">
    <div class="container-am">
      <Breadcrumbs homeHref={href("/")} homeLabel={t.nav.home} items={[{ href: href("/consulting"), label: t.nav.consulting }]} />
      <header class="intro">
        <div>
          <h1 class="display">{t.consultingPage.title}</h1>
          <p class="lead">{t.consultingPage.lead}</p>
          <p class="lead">{t.consultingPage.follow}</p>
          <p class="hero-cta">
            <a class="btn btn-primary" href="#demande">{t.consultingPage.cta}</a>
          </p>
        </div>
        {
          showPortrait && (
            <div class="photo">
              <Portrait src={settings.portrait} alt={t.about.photoAlt} sizes="(max-width: 879px) 58vw, 280px" />
            </div>
          )
        }
      </header>
      <section class="needs">
        <h2>{t.consultingPage.needsTitle}</h2>
        <ul>
          {needs.map((need) => (
            <li>
              <a href="#demande">
                <strong>{need.title}</strong>
                <span>{need.text}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
      <section class="path">
        <ProcessSteps steps={steps} numbered={false} />
      </section>
      <section class="clarify">
        <h2>{t.consultingPage.clarifyTitle}</h2>
        <p>{t.consultingPage.listLabel}</p>
        <ul>{t.consultingPage.items.map((item) => <li>{item}</li>)}</ul>
      </section>
      <h2 id="demande">{t.consultingPage.cta}</h2>
      {sent ? <p class="ok" role="status">{t.questions.success}</p> : <ConsultationForm action={href("/consulting")} errors={errors} values={values} />}
    </div>
  </section>
</BaseLayout>

<style>
  .consult {
    padding-top: clamp(1.6rem, 4vw, 3.2rem);
  }
  .intro {
    display: grid;
    gap: 1.6rem;
    margin-bottom: 2.4rem;
    align-items: center;
  }
  h1 {
    font-size: clamp(2.2rem, 7vw, 4.2rem);
    overflow-wrap: anywhere;
    line-height: 0.98;
    max-width: 12ch;
  }
  .lead {
    color: var(--fg-soft);
    margin: 0.6rem 0 0;
    max-width: 34rem;
  }
  .hero-cta {
    margin: 1.2rem 0 0;
  }
  .photo {
    max-width: 280px;
  }
  h2 {
    margin: 0 0 1rem;
    font-size: 1.05rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--mute);
  }
  .needs ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.8rem;
  }
  .needs a {
    display: grid;
    gap: 0.3rem;
    color: inherit;
    text-decoration: none;
    padding: 1rem 0;
    border-top: 1px solid var(--line);
    min-height: 44px;
  }
  .needs a:hover strong {
    color: var(--color-ember);
  }
  .needs span {
    color: var(--fg-soft);
  }
  .path,
  .clarify,
  .needs {
    margin: 2.4rem 0;
  }
  .clarify p,
  .clarify li {
    color: var(--fg-soft);
  }
  .clarify ul {
    padding-left: 1.1rem;
  }
  .ok {
    color: var(--color-ok);
  }
  @media (min-width: 880px) {
    .intro {
      grid-template-columns: minmax(0, 1.2fr) minmax(180px, 280px);
      gap: 3rem;
    }
    .needs ul {
      grid-template-columns: 1fr 1fr 1fr;
      gap: 1.2rem;
    }
    .needs a {
      border-top: 0;
      border-left: 1px solid var(--line);
      padding: 0 0 0 1rem;
    }
    .needs li:first-child a {
      border-left: 0;
      padding-left: 0;
    }
  }
</style>
