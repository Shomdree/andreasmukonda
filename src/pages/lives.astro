---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import EmptyState from "../components/EmptyState.astro";
import LiveCard from "../components/LiveCard.astro";
import SocialChannels from "../components/SocialChannels.astro";
import CTASection from "../components/CTASection.astro";
import { pageI18n } from "../i18n/request";
import { getLives, getSettings } from "../lib/queries";

const { t, href } = pageI18n(Astro.locals);
const settings = await getSettings();
const lives = await getLives();
---

<BaseLayout
  settings={settings}
  title={t.seo.livesTitle}
  description={t.seo.livesDescription}
  canonicalPath="/lives"
>
  <section class="section">
    <div class="container-am">
      <Breadcrumbs homeHref={href("/")} homeLabel={t.nav.home} items={[{ href: href("/lives"), label: t.nav.lives }]} />
      <h1 class="display">{t.lives.title}</h1>
      <p class="lead">{t.lives.lead}</p>
      <p class="lead">{t.lives.follow}</p>
      <ul>{t.lives.items.map((item) => <li>{item}</li>)}</ul>
      <div class="list">
        {lives.length ? lives.map((live) => <LiveCard live={live} />) : <EmptyState title={t.lives.empty} />}
      </div>
      <h2>{t.lives.cta}</h2>
      <SocialChannels settings={settings} />
    </div>
  </section>
  <CTASection title={t.lives.cta} primaryHref={href("/contact")} primaryLabel={t.nav.contact} />
</BaseLayout>

<style>
  h1 { font-size: clamp(2.4rem, 8vw, 4.4rem); }
  h2 { margin: 2.4rem 0 1rem; font-size: 1.3rem; }
  .lead, li { color: var(--fg-soft); margin: 0.5rem 0; }
  .list { display: grid; gap: 2.4rem; }
</style>
