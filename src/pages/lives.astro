---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import EmptyState from "../components/EmptyState.astro";
import LiveCard from "../components/LiveCard.astro";
import SocialChannels from "../components/SocialChannels.astro";
import CTASection from "../components/CTASection.astro";
import { pageI18n } from "../i18n/request";
import { getLives, getSettings } from "../lib/queries";

const { t, href } = pageI18n(Astro.locals);
const settings = await getSettings();
const lives = await getLives();
const groups = [
  { key: "en-direct" as const, title: t.lives.liveTitle, items: lives.filter((item) => item.status === "en-direct") },
  { key: "programme" as const, title: t.lives.scheduledTitle, items: lives.filter((item) => item.status === "programme") },
  { key: "replay" as const, title: t.lives.replayTitle, items: lives.filter((item) => item.status === "replay") },
].filter((group) => group.items.length > 0);
const featured = groups[0]?.items[0];
const restGroups = groups.map((group) => ({
  ...group,
  items: group.items.filter((item) => item.id !== featured?.id),
})).filter((group) => group.items.length > 0);
---

<BaseLayout
  settings={settings}
  title={t.seo.livesTitle}
  description={t.seo.livesDescription}
  canonicalPath="/lives"
>
  <section class="section library">
    <div class="container-am">
      <Breadcrumbs homeHref={href("/")} homeLabel={t.nav.home} items={[{ href: href("/lives"), label: t.nav.lives }]} />
      <header class="intro">
        <h1 class="display">{t.lives.title}</h1>
        <p class="lead">{t.lives.lead}</p>
        <p class="lead">{t.lives.follow}</p>
        <ul class="topics">{t.lives.items.map((item) => <li>{item}</li>)}</ul>
      </header>
      {featured && <LiveCard live={featured} featured />}
      {
        restGroups.map((group) => (
          <section class="shelf">
            <h2>{group.title}</h2>
            <div class="list">
              {group.items.map((live) => <LiveCard live={live} />)}
            </div>
          </section>
        ))
      }
      {lives.length === 0 && <EmptyState title={t.lives.empty} />}
      <section class="networks">
        <h2>{t.lives.cta}</h2>
        <SocialChannels settings={settings} />
      </section>
    </div>
  </section>
  <CTASection title={t.lives.cta} primaryHref={href("/contact")} primaryLabel={t.nav.contact} />
  <script is:inline src="/live-player.js"></script>
</BaseLayout>

<style>
  .library {
    padding-top: clamp(1.6rem, 4vw, 3.2rem);
  }
  .intro {
    max-width: 40rem;
    margin-bottom: 2rem;
  }
  h1 {
    font-size: clamp(2.1rem, 7vw, 4.2rem);
    overflow-wrap: anywhere;
    line-height: 0.98;
  }
  .lead {
    color: var(--fg-soft);
    margin: 0.55rem 0 0;
  }
  .topics {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 0.9rem;
    color: var(--fg-soft);
    padding: 0;
    margin: 0.9rem 0 0;
    list-style: none;
    font-size: 0.92rem;
  }
  .topics li::before {
    content: "";
    display: inline-block;
    width: 0.45rem;
    height: 0.45rem;
    margin-right: 0.45rem;
    background: var(--color-ember);
    border-radius: 1px;
    vertical-align: 0.15rem;
  }
  h2 {
    margin: 2.4rem 0 1rem;
    font-size: 0.95rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--mute);
  }
  .list {
    display: grid;
    gap: 2rem;
  }
  .networks {
    margin-top: 2.6rem;
    padding-top: 1.4rem;
    border-top: 1px solid var(--line);
  }
  @media (min-width: 820px) {
    .list {
      grid-template-columns: 1fr 1fr;
      gap: 1.6rem 1.2rem;
    }
  }
</style>
