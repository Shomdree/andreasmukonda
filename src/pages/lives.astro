---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import EmptyState from "../components/EmptyState.astro";
import LiveCard from "../components/LiveCard.astro";
import SocialChannels from "../components/SocialChannels.astro";
import CTASection from "../components/CTASection.astro";
import { pageI18n } from "../i18n/request";
import { localizeLive } from "../i18n/localize";
import { isCatalogVideo } from "../content/video-catalog";
import { getLives, getSettings } from "../lib/queries";
import { hasOptimizedPublicVariants, publicImageBase } from "../lib/public-file";

const { t, href, locale } = pageI18n(Astro.locals);
const settings = await getSettings();
const lives = (await getLives()).map((item) => localizeLive(item, locale));
const videos = lives.filter((item) => isCatalogVideo(item));
const restLives = lives.filter((item) => !isCatalogVideo(item));
const groups = [
  { key: "en-direct" as const, title: t.lives.liveTitle, items: restLives.filter((item) => item.status === "en-direct") },
  { key: "programme" as const, title: t.lives.scheduledTitle, items: restLives.filter((item) => item.status === "programme") },
  { key: "replay" as const, title: t.lives.replayTitle, items: restLives.filter((item) => item.status === "replay") },
].filter((group) => group.items.length > 0);
const featuredVideo = videos[0];
const otherVideos = videos.slice(1);
const featuredPoster = featuredVideo?.thumbnailUrl ?? "";
const featuredPosterBase = featuredPoster ? publicImageBase(featuredPoster) : "";
const featuredPosterOptimized = Boolean(featuredPoster && hasOptimizedPublicVariants(featuredPoster));
const featuredLive = groups[0]?.items[0];
const restGroups = groups.map((group) => ({
  ...group,
  items: group.items.filter((item) => item.id !== featuredLive?.id),
})).filter((group) => group.items.length > 0);
---

<BaseLayout
  settings={settings}
  title={t.seo.livesTitle}
  description={t.seo.livesDescription}
  canonicalPath="/lives"
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://www.tiktok.com" crossorigin="anonymous" />
    <link rel="dns-prefetch" href="https://www.tiktok.com" />
    {
      featuredPosterOptimized ? (
        <link rel="preload" as="image" type="image/avif" href={`${featuredPosterBase}-720.avif`} fetchpriority="high" />
      ) : featuredPoster ? (
        <link rel="preload" as="image" href={featuredPoster} fetchpriority="high" />
      ) : null
    }
  </Fragment>
  <section class="section library">
    <div class="container-am">
      <Breadcrumbs homeHref={href("/")} homeLabel={t.nav.home} items={[{ href: href("/lives"), label: t.nav.lives }]} />
      <header class="intro">
        <h1 class="display">{t.lives.title}</h1>
        <p class="lead">{t.lives.lead}</p>
        <p class="lead">{t.lives.follow}</p>
        <ul class="topics">{t.lives.items.map((item) => <li>{item}</li>)}</ul>
      </header>
      {
        videos.length > 0 && (
          <section class="shelf videos">
            <h2>{t.lives.videosTitle}</h2>
            <p class="lead">{t.lives.videosLead}</p>
            {featuredVideo && <LiveCard live={featuredVideo} featured />}
            {otherVideos.length > 0 && (
              <div class="list">
                {otherVideos.map((live) => <LiveCard live={live} />)}
              </div>
            )}
          </section>
        )
      }
      {featuredLive && <LiveCard live={featuredLive} featured />}
      {
        restGroups.map((group) => (
          <section class="shelf">
            <h2>{group.title}</h2>
            <div class="list">
              {group.items.map((live) => <LiveCard live={live} />)}
            </div>
          </section>
        ))
      }
      {
        lives.length === 0 && (
          <div class="ready" aria-hidden="true">
            <div class="stage media-frame">
              <span class="play-mark"></span>
            </div>
          </div>
        )
      }
      {lives.length === 0 && <EmptyState title={t.lives.empty} />}
      <section class="networks">
        <h2>{t.lives.cta}</h2>
        <SocialChannels settings={settings} />
      </section>
    </div>
  </section>
  <CTASection title={t.lives.cta} primaryHref={href("/contact")} primaryLabel={t.nav.contact} />
</BaseLayout>

<style>
  .library {
    padding-top: clamp(1.6rem, 4vw, 3.2rem);
  }
  .intro {
    max-width: 40rem;
    margin-bottom: 2rem;
  }
  h1 {
    font-size: clamp(2.1rem, 7vw, 4.2rem);
    overflow-wrap: anywhere;
    line-height: 0.98;
  }
  .lead {
    color: var(--fg-soft);
    margin: 0.55rem 0 0;
  }
  .topics {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 0.9rem;
    color: var(--fg-soft);
    padding: 0;
    margin: 0.9rem 0 0;
    list-style: none;
    font-size: 0.92rem;
  }
  .topics li::before {
    content: "";
    display: inline-block;
    width: 0.45rem;
    height: 0.45rem;
    margin-right: 0.45rem;
    background: var(--color-ember);
    border-radius: 1px;
    vertical-align: 0.15rem;
  }
  h2 {
    margin: 2.4rem 0 1rem;
    font-size: 0.95rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--mute);
  }
  .videos > .lead {
    max-width: 40rem;
    margin: 0 0 1.5rem;
  }
  .videos .list {
    margin-top: 2rem;
  }
  .list {
    display: grid;
    gap: 2rem;
  }
  .networks {
    margin-top: 2.6rem;
    padding-top: 1.4rem;
    border-top: 1px solid var(--line);
  }
  .ready {
    margin: 0 0 1.4rem;
  }
  .ready .stage {
    position: relative;
    aspect-ratio: 16 / 9;
    background: #10131a;
  }
  .play-mark {
    position: absolute;
    inset: 0;
    width: 4.2rem;
    height: 4.2rem;
    min-width: 44px;
    min-height: 44px;
    margin: auto;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-ember) 92%, #000);
    box-shadow: 0 0 0 8px color-mix(in srgb, var(--color-ember) 22%, transparent);
  }
  .play-mark::after {
    content: "";
    position: absolute;
    inset: 0;
    margin: auto;
    width: 0;
    height: 0;
    border-style: solid;
    border-width: 0.7rem 0 0.7rem 1.15rem;
    border-color: transparent transparent transparent #10131a;
    transform: translateX(0.18rem);
  }
  @media (min-width: 820px) {
    .list {
      grid-template-columns: 1fr 1fr;
      gap: 1.6rem 1.2rem;
    }
  }
</style>
