---
import BaseLayout from "../layouts/BaseLayout.astro";
import { pageI18n } from "../i18n/request";
import { getSettings } from "../lib/queries";
const { t } = pageI18n(Astro.locals);
const settings = await getSettings();
---

<BaseLayout settings={settings} title={`${t.legal.privacyTitle} — Andréas Mukonda`} canonicalPath="/confidentialite">
  <article class="section">
    <div class="container-am prose">
      <h1 class="display">{t.legal.privacyTitle}</h1>
      <p>{t.legal.dataBody}</p>
    </div>
  </article>
</BaseLayout>

<style>
  h1 { font-size: 2.4rem; margin-bottom: 1rem; }
  .prose p { color: var(--fg-soft); margin-bottom: 0.8rem; max-width: 40rem; }
</style>
