---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import CTASection from "../../components/CTASection.astro";
import ResponsiveImage from "../../components/ResponsiveImage.astro";
import { pageI18n } from "../../i18n/request";
import { localizeCategory } from "../../i18n/localize";
import { getProject, getSettings } from "../../lib/queries";

const { t, href } = pageI18n(Astro.locals);
const settings = await getSettings();
const project = await getProject(Astro.params.slug ?? "");
if (!project) return Astro.redirect(href("/"));
const categoryName = project.category ? localizeCategory(project.category, t).name : t.catalog.project;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  name: project.title,
  description: project.excerpt,
  dateCreated: project.year,
};
---

<BaseLayout
  settings={settings}
  title={`${project.title} — ${t.nav.portfolio}`}
  description={project.excerpt}
  image={project.coverImage}
  canonicalPath={`/portfolio/${project.slug}`}
  jsonLd={jsonLd}
>
  <article>
    <div class="hero media-frame">
      <ResponsiveImage src={project.coverImage} alt={project.coverAlt} width={1600} height={900} eager />
    </div>
    <div class="section">
      <div class="container-am">
        <Breadcrumbs
          homeHref={href("/")}
          homeLabel={t.nav.home}
          items={[
            { href: href("/portfolio"), label: t.nav.portfolio },
            { href: href(`/portfolio/${project.slug}`), label: project.title },
          ]}
        />
        <p class="kicker">{categoryName} · {project.year}</p>
        <h1 class="display">{project.title}</h1>
        <p class="lead">{project.excerpt}</p>
        <dl>
          <div><dt>{t.catalog.client}</dt><dd>{project.client}</dd></div>
          <div><dt>{t.nav.services}</dt><dd>{project.servicesDone.join(", ")}</dd></div>
        </dl>
        <h2>{t.catalog.projectContext}</h2>
        <p>{project.description}</p>
        <h2>{t.catalog.projectChallenge}</h2>
        <p>{project.challenge}</p>
        <h2>{t.catalog.projectApproach}</h2>
        <p>{project.solution}</p>
        {project.results && (
          <>
            <h2>{t.catalog.projectResults}</h2>
            <p>{project.results}</p>
          </>
        )}
        {
          project.gallery.length > 0 && (
            <>
              <h2>{t.catalog.projectGallery}</h2>
              <div class="gallery">
                {project.gallery.map((item) => (
                  <div class="media-frame">
                    <ResponsiveImage src={item.url} alt={item.alt} width={1000} height={1250} />
                  </div>
                ))}
              </div>
            </>
          )
        }
      </div>
    </div>
  </article>
  <CTASection
    title={t.portfolio.cta}
    primaryHref={`${href("/commander")}?service=${project.category?.slug ?? "identite-visuelle"}`}
    primaryLabel={t.nav.order}
    secondaryHref={href("/portfolio")}
    secondaryLabel={t.nav.portfolio}
  />
</BaseLayout>

<style>
  .hero { aspect-ratio: 16 / 9; max-height: 72vh; }
  h1 { font-size: clamp(2rem, 7vw, 4rem); max-width: 18ch; }
  .lead, p { color: var(--fg-soft); }
  h2 { margin-top: 1.8rem; font-size: 1.1rem; }
  dl { display: grid; gap: 0.8rem; margin: 1.4rem 0; }
  dt { color: var(--mute); font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.12em; }
  .gallery { display: grid; gap: 1rem; margin-top: 1rem; }
  @media (min-width: 800px) { .gallery { grid-template-columns: 1fr 1fr; } }
</style>
