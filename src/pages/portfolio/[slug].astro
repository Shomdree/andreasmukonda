---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import CTASection from "../../components/CTASection.astro";
import ResponsiveImage from "../../components/ResponsiveImage.astro";
import { pageI18n } from "../../i18n/request";
import { localizeProject } from "../../i18n/localize";
import { getProject, getSettings } from "../../lib/queries";
import { isPosterProject } from "../../content/poster-catalog";
import { isLogoProject } from "../../content/logo-catalog";
import { publicFileExists } from "../../lib/public-file";
import VideoPlayer from "../../components/VideoPlayer.astro";

const { t, href, locale } = pageI18n(Astro.locals);
const settings = await getSettings();
const found = await getProject(Astro.params.slug ?? "");
if (!found) return Astro.redirect(href("/"));
const project = localizeProject(found, t, locale);
const categoryName = project.category?.name ?? t.catalog.project;
const showImage = publicFileExists(project.coverImage);
const gallery = project.gallery.filter((item) => publicFileExists(item.url));
const markWork = isPosterProject(project) || isLogoProject(project);
const videoUrl = project.videoUrl?.trim() || "";
const orderHref = markWork
  ? `${href("/commander")}?service=design-graphique`
  : `${href("/commander")}?service=${project.category?.slug ?? "identite-visuelle"}`;
const chapters = [
  { title: t.portfolio.need, text: project.challenge || project.description },
  { title: t.portfolio.approach, text: project.solution },
  { title: t.portfolio.result, text: project.results },
].filter((item, index, all) => {
  if (!item.text?.trim()) return false;
  return all.findIndex((other) => other.text === item.text) === index;
});

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  name: project.title,
  description: project.excerpt,
  dateCreated: project.year,
};
---

<BaseLayout
  settings={settings}
  title={`${project.title} — ${t.nav.portfolio}`}
  description={project.excerpt}
  image={showImage ? project.coverImage : undefined}
  canonicalPath={`/portfolio/${project.slug}`}
  jsonLd={jsonLd}
>
  <article class="work">
    {
      videoUrl ? (
        <div class="hero video-hero">
          <VideoPlayer
            url={videoUrl}
            title={project.title}
            poster={showImage ? project.coverImage : undefined}
            playLabel={t.lives.playVideo}
            playerTitle={t.catalog.videoPlayer}
            eager
          />
        </div>
      ) : (
        <div class:list={["hero", "media-frame", isLogoProject(project) && "logo-hero"]}>
          {showImage ? (
            <ResponsiveImage
              src={project.coverImage}
              alt={project.coverAlt}
              width={960}
              height={1358}
              sizes="100vw"
              eager
            />
          ) : null}
        </div>
      )
    }
    <div class="section">
      <div class="container-am">
        <Breadcrumbs
          homeHref={href("/")}
          homeLabel={t.nav.home}
          items={[
            { href: href("/portfolio"), label: t.nav.portfolio },
            { href: href(`/portfolio/${project.slug}`), label: project.title },
          ]}
        />
        <p class="kicker">{categoryName}{project.year ? ` · ${project.year}` : ""}</p>
        <h1 class="display">{project.title}</h1>
        {project.excerpt && <p class="lead">{project.excerpt}</p>}
        <dl>
          {project.client && (
            <div>
              <dt>{t.catalog.client}</dt>
              <dd>{project.client}</dd>
            </div>
          )}
          {project.servicesDone.length > 0 && (
            <div>
              <dt>{t.nav.services}</dt>
              <dd>{project.servicesDone.join(", ")}</dd>
            </div>
          )}
        </dl>
        {
          chapters.map((chapter, index) => (
            <section class:list={["chapter", index % 2 === 1 && "alt"]}>
              <h2>{chapter.title}</h2>
              <p>{chapter.text}</p>
            </section>
          ))
        }
        {
          gallery.length > 0 && (
            <>
              <h2>{t.catalog.projectGallery}</h2>
              <div class="gallery">
                {gallery.map((item, index) => {
                  const popId = `work-${index}`;
                  return (
                    <>
                      <button type="button" class="shot media-frame" popovertarget={popId} aria-label={t.portfolio.openWork}>
                        <ResponsiveImage src={item.url} alt={item.alt} width={720} height={1018} sizes="(max-width: 799px) 92vw, 28rem" />
                      </button>
                      <div id={popId} popover="auto" class="work-pop">
                        <button type="button" class="close" popovertarget={popId} popovertargetaction="hide">
                          {t.portfolio.close}
                        </button>
                        <img src={item.url} alt={item.alt} />
                      </div>
                    </>
                  );
                })}
              </div>
            </>
          )
        }
      </div>
    </div>
  </article>
  <CTASection
    title={t.portfolio.cta}
    primaryHref={orderHref}
    primaryLabel={t.portfolio.similarCta}
    secondaryHref={href("/portfolio")}
    secondaryLabel={t.nav.portfolio}
  />
</BaseLayout>

<style>
  .work {
    min-width: 0;
  }
  .hero {
    aspect-ratio: 16 / 9;
    max-height: 64vh;
  }
  .video-hero {
    aspect-ratio: auto;
    max-height: none;
    background: transparent;
  }
  .hero :global(img) {
    object-fit: contain;
    height: 100%;
  }
  .logo-hero {
    aspect-ratio: 1 / 1;
    max-width: min(34rem, 100%);
    max-height: none;
    margin-inline: auto;
    background: color-mix(in srgb, var(--bg) 78%, #fff);
    padding: 1.4rem;
  }
  .logo-hero :global(img) {
    background: transparent;
  }
  h1 {
    font-size: clamp(2rem, 7vw, 3.8rem);
    max-width: 18ch;
    overflow-wrap: anywhere;
    line-height: 0.98;
  }
  .lead,
  p {
    color: var(--fg-soft);
  }
  .lead {
    font-size: 1.12rem;
    max-width: 40rem;
  }
  h2 {
    margin: 0 0 0.6rem;
    font-size: 1.05rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-ember);
  }
  dl {
    display: grid;
    gap: 0.8rem;
    margin: 1.4rem 0 2rem;
  }
  dt {
    color: var(--mute);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }
  .chapter {
    padding: 1.4rem 0;
    border-top: 1px solid var(--line);
    max-width: 42rem;
  }
  .gallery {
    display: grid;
    gap: 1rem;
    margin-top: 1rem;
  }
  .shot {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    cursor: zoom-in;
    background: color-mix(in srgb, var(--bg-elev) 80%, #1c2230);
  }
  .shot :global(img) {
    object-fit: contain;
    height: 100%;
  }
  .work-pop {
    border: 0;
    padding: 1rem;
    background: rgba(8, 10, 14, 0.94);
    color: var(--fg);
    width: min(96vw, 1100px);
  }
  .work-pop img {
    display: block;
    max-width: 100%;
    max-height: 82vh;
    width: auto;
    height: auto;
    margin-inline: auto;
    object-fit: contain;
  }
  .close {
    display: inline-flex;
    min-height: 44px;
    margin-bottom: 0.6rem;
    border: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
    font-weight: 650;
  }
  @media (min-width: 800px) {
    .gallery {
      grid-template-columns: 1fr 1fr;
    }
    dl {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
