---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import EmptyState from "../../components/EmptyState.astro";
import Pagination from "../../components/Pagination.astro";
import PortfolioFilter from "../../components/PortfolioFilter.astro";
import PortfolioGrid from "../../components/PortfolioGrid.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import LogoWall from "../../components/LogoWall.astro";
import CTASection from "../../components/CTASection.astro";
import { pageI18n } from "../../i18n/request";
import { isLogoProject } from "../../content/logo-catalog";
import { getCategories, getProjects, getSettings } from "../../lib/queries";

const { t, href } = pageI18n(Astro.locals);
const settings = await getSettings();
const [projects, categories] = await Promise.all([getProjects(), getCategories()]);
const current = Astro.url.searchParams.get("categorie");
const page = Math.max(1, Number(Astro.url.searchParams.get("page") ?? "1"));
const pageSize = 8;
const logos = projects.filter((item) => isLogoProject(item));
const posters = projects.filter((item) => !isLogoProject(item));
const showLogos = !current || current === "branding";
const filtered = current === "branding" ? [] : current ? posters.filter((p) => p.category?.slug === current) : posters;
const spotlight = !current ? filtered.find((item) => item.featured) : undefined;
const rest = spotlight ? filtered.filter((item) => item.id !== spotlight.id) : filtered;
const slice = rest.slice(0, page * pageSize);
const hasMore = slice.length < rest.length;
const nextHref = `${href("/portfolio")}?${new URLSearchParams({
  ...(current ? { categorie: current } : {}),
  page: String(page + 1),
}).toString()}`;
---

<BaseLayout
  settings={settings}
  title={t.seo.portfolioTitle}
  description={t.seo.portfolioDescription}
  canonicalPath="/portfolio"
>
  <section class="section gallery-page">
    <div class="container-wide">
      <Breadcrumbs homeHref={href("/")} homeLabel={t.nav.home} items={[{ href: href("/portfolio"), label: t.nav.portfolio }]} />
      <header class="intro">
        <h1 class="display">{t.portfolio.title}</h1>
        <p class="lead">{t.portfolio.lead}</p>
        <p class="lead follow">{t.portfolio.follow}</p>
        <ul class="topics">{t.portfolio.items.map((item) => <li>{item}</li>)}</ul>
      </header>
      <PortfolioFilter categories={categories} current={current} />
      {
        showLogos && logos.length > 0 && (
          <section class="logos" id="logos">
            <header class="logos-intro">
              <p class="kicker">{t.catalog.categories.branding}</p>
              <h2 class="display">{t.portfolio.logosTitle}</h2>
              <p>{t.portfolio.logosLead}</p>
            </header>
            <LogoWall logos={logos} />
          </section>
        )
      }
      {
        spotlight && (
          <div class="spotlight">
            <ProjectCard project={spotlight} featured contain />
          </div>
        )
      }
      {slice.length ? <PortfolioGrid projects={slice} variant="gallery" /> : !spotlight && !showLogos && <EmptyState title={t.portfolio.empty} />}
      <Pagination hasMore={hasMore} nextHref={nextHref} label={t.catalog.seeMore} />
    </div>
  </section>
  <CTASection title={t.portfolio.cta} primaryHref={href("/commander")} primaryLabel={t.portfolio.similarCta} />
</BaseLayout>

<style>
  .gallery-page {
    padding-top: clamp(1.6rem, 4vw, 3.2rem);
  }
  .intro {
    max-width: 40rem;
    margin-bottom: 1.6rem;
  }
  h1 {
    font-size: clamp(2.2rem, 7vw, 4.6rem);
    line-height: 0.96;
    margin: 0.15rem 0 0.8rem;
    overflow-wrap: anywhere;
  }
  .lead {
    color: var(--fg-soft);
    margin: 0 0 0.7rem;
    font-size: 1.05rem;
  }
  .follow {
    margin-bottom: 0.9rem;
  }
  .topics {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 0.9rem;
    color: var(--fg-soft);
    padding: 0;
    margin: 0;
    list-style: none;
    font-size: 0.92rem;
  }
  .topics li::before {
    content: "";
    display: inline-block;
    width: 0.45rem;
    height: 0.45rem;
    margin-right: 0.45rem;
    background: var(--color-ember);
    border-radius: 1px;
    vertical-align: 0.15rem;
  }
  .logos {
    margin: 0 0 2.8rem;
    padding-bottom: 2.2rem;
    border-bottom: 1px solid var(--line);
  }
  .logos-intro {
    max-width: 38rem;
    margin-bottom: 1.3rem;
  }
  .logos h2 {
    font-size: clamp(1.6rem, 4vw, 2.3rem);
    margin: 0.15rem 0 0.55rem;
    letter-spacing: -0.03em;
  }
  .logos p {
    color: var(--fg-soft);
    margin: 0;
  }
  .spotlight {
    margin: 0 0 2.4rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--line);
  }
</style>
