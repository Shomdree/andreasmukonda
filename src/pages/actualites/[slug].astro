---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { pageI18n } from "../../i18n/request";
import { getPost, getSettings } from "../../lib/queries";

const { t, href } = pageI18n(Astro.locals);
const settings = await getSettings();
const post = await getPost(Astro.params.slug ?? "");
if (!post) return Astro.redirect(href("/"));

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: post.title,
  datePublished: post.publishedAt,
  author: { "@type": "Person", name: settings.name },
};
---

<BaseLayout
  settings={settings}
  title={`${post.title} — Actualités`}
  description={post.excerpt}
  image={post.coverImage}
  canonicalPath={`/actualites/${post.slug}`}
  jsonLd={jsonLd}
>
  <article class="section">
    <div class="container-am prose">
      <Breadcrumbs
        homeHref={href("/")}
        homeLabel={t.nav.home}
        items={[
          { href: href("/actualites"), label: t.nav.news },
          { href: href(`/actualites/${post.slug}`), label: post.title },
        ]}
      />
      <p class="kicker">{post.category}</p>
      <h1 class="display">{post.title}</h1>
      {post.publishedAt && <time datetime={post.publishedAt}>{post.publishedAt}</time>}
      <p class="lead">{post.excerpt}</p>
      <p>{post.content}</p>
    </div>
  </article>
</BaseLayout>

<style>
  h1 { font-size: clamp(2rem, 7vw, 3.6rem); max-width: 18ch; }
  .lead, p, time { color: var(--fg-soft); }
  time { display: block; margin: 0.6rem 0 1rem; }
</style>
