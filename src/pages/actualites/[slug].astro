---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import NewsKind from "../../components/NewsKind.astro";
import ResponsiveImage from "../../components/ResponsiveImage.astro";
import { editorialImages, newsKindFromCategory } from "../../content/news-kinds";
import { pageI18n } from "../../i18n/request";
import { localizePost } from "../../i18n/localize";
import { getPost, getPosts, getSettings } from "../../lib/queries";

const { t, href, locale } = pageI18n(Astro.locals);
const settings = await getSettings();
const found = await getPost(Astro.params.slug ?? "");
if (!found) return Astro.redirect(href("/"));
const post = localizePost(found, locale);
const kind = newsKindFromCategory(post.category);
const pictures = editorialImages(post);
const related = (await getPosts())
  .map((item) => localizePost(item, locale))
  .filter((item) => item.id !== post.id && newsKindFromCategory(item.category) === kind)
  .slice(0, 3);
const paragraphs = post.content
  .split(/\n{2,}/)
  .map((item) => item.trim())
  .filter((item) => item && item !== post.excerpt.trim());
const words = `${post.excerpt} ${post.content}`.trim().split(/\s+/).filter(Boolean).length;
const reading = t.news.readingTime.replace("{n}", String(Math.max(1, Math.round(words / 200) || 1)));
const date = post.publishedAt ? new Date(post.publishedAt) : null;
const dateOk = Boolean(date && !Number.isNaN(date.getTime()));
const dateLabel = dateOk
  ? date!.toLocaleDateString(locale === "en" ? "en-GB" : "fr-FR", { dateStyle: "long" })
  : "";
const shareHref = `mailto:?subject=${encodeURIComponent(post.title)}&body=${encodeURIComponent(`${post.title}\n${Astro.url.href}`)}`;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: post.title,
  datePublished: post.publishedAt,
  author: { "@type": "Person", name: settings.name },
};
---

<BaseLayout
  settings={settings}
  title={`${post.title} — ${t.nav.news}`}
  description={post.excerpt}
  image={pictures[0]?.url}
  canonicalPath={`/actualites/${post.slug}`}
  jsonLd={jsonLd}
>
  <article class="section reading">
    <div class="container-am">
      <Breadcrumbs
        homeHref={href("/")}
        homeLabel={t.nav.home}
        items={[
          { href: href("/actualites"), label: t.nav.news },
          { href: href(`/actualites/${post.slug}`), label: post.title },
        ]}
      />
      <NewsKind category={post.category} />
      <h1 class="display">{post.title}</h1>
      <p class="meta">
        <span>{settings.name}</span>
        {dateOk && <time datetime={post.publishedAt}>{dateLabel}</time>}
        <span>{reading}</span>
      </p>
      {post.excerpt && <p class="lead">{post.excerpt}</p>}
      {
        pictures.length > 0 && (
          <figure class:list={["gallery", pictures.length === 1 && "single"]}>
            {pictures.length > 1 && <figcaption class="kicker">{t.news.gallery}</figcaption>}
            <div class="shots">
              {pictures.map((item, index) => {
                const popId = `news-image-${index}`;
                return (
                  <>
                    <button type="button" class="shot media-frame" popovertarget={popId} aria-label={t.news.openImage}>
                      <ResponsiveImage
                        src={item.url}
                        alt={item.alt}
                        width={1200}
                        height={800}
                        eager={index === 0}
                        sizes={pictures.length === 1 ? "(max-width: 799px) 92vw, 42rem" : "(max-width: 799px) 92vw, 22rem"}
                      />
                    </button>
                    <div id={popId} popover="auto" class="image-pop">
                      <button type="button" class="close" popovertarget={popId} popovertargetaction="hide">
                        {t.news.closeImage}
                      </button>
                      <img src={item.url} alt={item.alt} />
                    </div>
                  </>
                );
              })}
            </div>
          </figure>
        )
      }
      <div class="prose">
        {paragraphs.map((item) => <p>{item}</p>)}
      </div>
      <p class="share">
        <a href={shareHref}>{t.news.share}</a>
      </p>
      {
        related.length > 0 && (
          <aside class="related">
            <h2>{t.news.related}</h2>
            <ul>
              {related.map((item) => (
                <li>
                  <a href={href(`/actualites/${item.slug}`)}>{item.title}</a>
                </li>
              ))}
            </ul>
          </aside>
        )
      }
    </div>
  </article>
</BaseLayout>

<style>
  .reading {
    padding-top: clamp(1.6rem, 4vw, 3rem);
  }
  h1 {
    font-size: clamp(2rem, 7vw, 3.5rem);
    max-width: 18ch;
    overflow-wrap: anywhere;
    line-height: 0.98;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.9rem;
    color: var(--mute);
    font-size: 0.9rem;
    margin: 0.8rem 0 1.2rem;
  }
  .lead {
    color: var(--fg-soft);
    font-size: 1.2rem;
    line-height: 1.55;
    max-width: 40rem;
  }
  .gallery {
    margin: 1.6rem 0 0;
    max-width: 42rem;
  }
  .gallery .kicker {
    margin-bottom: 0.7rem;
  }
  .shots {
    display: grid;
    gap: 0.8rem;
  }
  .shot {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    cursor: zoom-in;
    aspect-ratio: 16 / 10;
  }
  .shot :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .image-pop {
    border: 0;
    padding: 1rem;
    background: rgba(8, 10, 14, 0.94);
    color: var(--fg);
    width: min(96vw, 1100px);
  }
  .image-pop img {
    display: block;
    max-width: 100%;
    max-height: 82vh;
    width: auto;
    height: auto;
    margin-inline: auto;
    object-fit: contain;
  }
  .close {
    display: inline-flex;
    min-height: 44px;
    margin-bottom: 0.6rem;
    border: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
    font-weight: 650;
  }
  .prose {
    max-width: 42rem;
    margin-top: 1.6rem;
  }
  @media (min-width: 800px) {
    .shots {
      grid-template-columns: 1fr 1fr;
    }
    .single .shots {
      grid-template-columns: 1fr;
    }
  }
  .prose p {
    color: var(--fg);
    font-size: 1.125rem;
    line-height: 1.75;
    margin: 0 0 1.15rem;
    text-align: left;
  }
  .share {
    margin-top: 2rem;
  }
  .share a {
    color: var(--fg-soft);
  }
  .related {
    margin-top: 2.4rem;
    padding-top: 1.2rem;
    border-top: 1px solid var(--line);
  }
  .related h2 {
    font-size: 1rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--mute);
  }
  .related ul {
    padding-left: 1.1rem;
  }
  .related a {
    color: inherit;
  }
</style>
