---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import FAQAccordion from "../components/FAQAccordion.astro";
import QuestionCard from "../components/QuestionCard.astro";
import QuestionForm from "../components/QuestionForm.astro";
import { pageI18n } from "../i18n/request";
import { fr } from "../i18n/fr";
import { en } from "../i18n/en";
import { ln } from "../i18n/ln";
import { submitQuestion } from "../lib/actions";
import { getFaq, getPublicQuestions, getSettings } from "../lib/queries";
import { questionCategories } from "../content/defaults";
import { localizeQuestionCategory } from "../i18n/localize";
import { collectKnownQuestions, findKnownQuestion } from "../lib/question-match";

const { t, href } = pageI18n(Astro.locals);
const settings = await getSettings();
const [questions, faqRows] = await Promise.all([getPublicQuestions(), getFaq()]);
const theme = Astro.url.searchParams.get("theme");
const visible = theme ? questions.filter((item) => item.category === theme) : questions;
const usedThemes = questionCategories.filter((item) => questions.some((entry) => entry.category === item));
const faqItems = t.faq.items.map((item) => ({ question: item.q, answer: item.a }));
const known = collectKnownQuestions({
  faqDisplay: t.faq.items,
  faqNeedles: fr.faq.items.map((_, index) =>
    [fr.faq.items[index]?.q, ln.faq.items[index]?.q, en.faq.items[index]?.q].filter(
      (value): value is string => Boolean(value),
    ),
  ),
  publicQuestions: questions,
  extraFaq: faqRows,
});
const extraFaq = known
  .filter((item) => item.source === "faq" && item.id.startsWith("faq-extra-"))
  .map((item) => ({ question: item.question, answer: item.answer }));
let errors: Record<string, string> | undefined;
let values: Record<string, string> | undefined;
let sent = Astro.url.searchParams.get("ok") === "1";
let duplicate = known.find((item) => item.id === Astro.url.searchParams.get("deja"));

if (Astro.request.method === "POST") {
  const result = await submitQuestion(Astro.request, await Astro.request.formData());
  if (result.ok) return Astro.redirect(`${href("/questions")}?ok=1`);
  errors = result.errors;
  values = result.values;
  if (errors.duplicate === "pending") {
    duplicate = {
      id: "pending",
      source: "public",
      needles: [],
      question: values.question ?? "",
      answer: "",
    };
  } else if (errors.duplicate) {
    duplicate = known.find((item) => item.id === errors?.duplicate) ?? findKnownQuestion(values.question ?? "", known);
  }
}

const knownJson = JSON.stringify(known).replace(/</g, "\\u003c");
const pendingOnly = duplicate?.id === "pending";
---

<BaseLayout
  settings={settings}
  title={t.seo.questionsTitle}
  description={t.seo.questionsDescription}
  canonicalPath="/questions"
>
  <script is:inline type="application/json" id="known-questions" set:html={knownJson}></script>
  <section class="section desk">
    <div class="container-am">
      <Breadcrumbs homeHref={href("/")} homeLabel={t.nav.home} items={[{ href: href("/questions"), label: t.nav.questions }]} />
      <header class="intro">
        <h1 class="display">{t.questions.title}</h1>
        <p class="lead">{t.questions.lead}</p>
        <p class="lead">{t.questions.follow}</p>
        <nav class="actions" aria-label={t.nav.questions}>
          <a class="btn btn-ghost" href="#faq">{t.questions.faqTitle}</a>
          <a class="btn btn-ghost" href="#reponses">{t.questions.find}</a>
          <a class="btn btn-primary" href="#poser">{t.questions.ask}</a>
        </nav>
      </header>
      <section id="faq" class="faq-block">
        <h2>{t.questions.faqTitle}</h2>
        <p class="hint">{t.questions.faqLead}</p>
        <FAQAccordion items={[...faqItems, ...extraFaq]} />
        <p class="to-form">
          <a href={href("/faq")}>{t.questions.faqMore}</a>
        </p>
      </section>
      <details class="demo">
        <summary>{t.questions.demoSummary}</summary>
        <p class="label">{t.questions.demoLabel}</p>
        <p><strong>{t.questions.demoQuestion}</strong></p>
        <p>{t.questions.demoAnswer}</p>
        <p><a href="#poser">{t.questions.demoCta}</a></p>
      </details>
      <section id="reponses" class="answers">
        {
          usedThemes.length > 0 && (
            <nav class="themes" aria-label={t.questions.find}>
              <a class:list={["chip", !theme && "on"]} href={href("/questions")}>{t.questions.allThemes}</a>
              {usedThemes.map((item) => (
                <a class:list={["chip", theme === item && "on"]} href={`${href("/questions")}?theme=${encodeURIComponent(item)}`}>
                  {localizeQuestionCategory(item, t)}
                </a>
              ))}
            </nav>
          )
        }
        {visible.map((item) => <QuestionCard item={item} />)}
        {questions.length > 0 && visible.length === 0 && <p class="hint">{t.questions.notFound}</p>}
        <p class="to-form">
          <a class="btn btn-ghost" href="#poser">{questions.length ? t.questions.notFound : t.questions.ask}</a>
        </p>
      </section>
      <section id="poser" class="ask">
        <h2>{t.questions.ask}</h2>
        <p class="hint">{t.questions.note}</p>
        {
          sent ? (
            <p class="ok" role="status">{t.questions.success}</p>
          ) : (
            <QuestionForm action={href("/questions")} errors={errors?.duplicate ? { ...errors, form: "" } : errors} values={values}>
              <aside
                slot="known"
                id="q-known"
                class="known"
                hidden={!duplicate}
                role="status"
                data-already-asked={t.questions.alreadyAsked}
                data-already-asked-lead={t.questions.alreadyAskedLead}
                data-already-asked-cta={t.questions.alreadyAskedCta}
              >
                <p class="known-kicker" data-known-title>{t.questions.alreadyAsked}</p>
                <p data-known-lead>{pendingOnly ? t.questions.alreadyAskedPending : t.questions.alreadyAskedLead}</p>
                <p class="known-q" data-known-question>{duplicate?.question ?? ""}</p>
                <p data-known-answer>{duplicate?.answer ?? ""}</p>
                <a
                  class="known-link"
                  data-known-link
                  hidden={pendingOnly}
                  href={duplicate && duplicate.source === "faq" ? "#faq" : duplicate ? `#${duplicate.id}` : "#faq"}
                >
                  {t.questions.alreadyAskedCta}
                </a>
              </aside>
            </QuestionForm>
          )
        }
      </section>
    </div>
  </section>
</BaseLayout>

<style>
  .desk {
    padding-top: clamp(1.6rem, 4vw, 3.2rem);
  }
  .intro {
    max-width: 38rem;
  }
  h1 {
    font-size: clamp(2.1rem, 7vw, 3.8rem);
    max-width: 16ch;
    overflow-wrap: anywhere;
    line-height: 0.98;
  }
  .lead,
  .hint {
    color: var(--fg-soft);
    margin: 0.6rem 0 0;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-top: 1.3rem;
  }
  .faq-block {
    margin-top: 2.2rem;
    max-width: 40rem;
  }
  .faq-block h2,
  .ask h2 {
    font-size: 1.4rem;
    margin-bottom: 0.4rem;
  }
  .demo {
    margin: 2rem 0 0;
    padding: 0.9rem 0;
    border-top: 1px solid var(--line);
    max-width: 38rem;
  }
  .demo summary {
    cursor: pointer;
    min-height: 44px;
    display: flex;
    align-items: center;
    font-weight: 650;
  }
  .demo .label {
    color: var(--mute);
    font-size: 0.82rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-top: 0.8rem;
  }
  .answers {
    margin-top: 2.2rem;
  }
  .themes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-bottom: 1rem;
  }
  .chip {
    min-height: 44px;
    padding: 0.35rem 0.85rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--fg-soft);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
  }
  .on,
  .chip:hover {
    color: var(--fg);
    border-color: var(--fg);
  }
  .to-form {
    margin-top: 1.4rem;
  }
  .ask {
    margin-top: 2.6rem;
    padding-top: 1.4rem;
    border-top: 1px solid var(--line);
  }
  .known {
    margin: 0 0 1.1rem;
    padding: 1rem 1.05rem;
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--bg-elev) 88%, var(--color-ember));
    max-width: 36rem;
  }
  .known[hidden] {
    display: none;
  }
  .known-kicker {
    margin: 0 0 0.35rem;
    font-weight: 700;
  }
  .known p {
    margin: 0.35rem 0 0;
    color: var(--fg-soft);
  }
  .known-q {
    color: var(--fg) !important;
    font-weight: 650;
  }
  .known-q:empty,
  [data-known-answer]:empty {
    display: none;
  }
  .known-link[hidden] {
    display: none;
  }
  .known-link {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    margin-top: 0.55rem;
    font-weight: 650;
  }
  .ok {
    color: var(--color-ok);
    font-size: 1.1rem;
  }
</style>
