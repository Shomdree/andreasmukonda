---
import type { SiteSettings } from "../lib/types";
import SocialLinks from "./SocialLinks.astro";
import { pageI18n } from "../i18n/request";
import { identity } from "../i18n/identity";

type Props = { settings: SiteSettings };
const { settings } = Astro.props;
const { t, href } = pageI18n(Astro.locals);
const year = new Date().getFullYear();
const logoSrcSet = settings.logo?.includes("/images/andreas/logo")
  ? "/images/andreas/logo.png 1x, /images/andreas/logo@2x.png 2x"
  : undefined;

const extraLinks = [
  { href: href("/contact"), label: t.nav.contact },
  { href: href("/consulting"), label: t.nav.consulting },
  { href: href("/questions"), label: t.nav.questions },
  { href: href("/actualites"), label: t.nav.news },
];
---

<footer class="site-footer">
  <div class="container-wide bar">
    <div class="brand">
      {
        settings.logo && (
          <img
            class="foot-logo"
            src={settings.logo}
            srcset={logoSrcSet}
            alt={identity.name}
            width="175"
            height="96"
            decoding="async"
          />
        )
      }
      {!settings.logo && <p class="display name">{identity.name}</p>}
    </div>

    <nav aria-label={t.a11y.footerNav}>
      {extraLinks.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))}
    </nav>

    <div class="social">
      <SocialLinks links={settings.socialLinks} whatsapp={settings.whatsapp} compact />
    </div>
  </div>

  <div class="container-wide contact-row">
    {
      settings.email && (
        <a href={`mailto:${settings.email}`}>{settings.email}</a>
      )
    }
    {t.contact.location && <span class="meta">{t.contact.location}</span>}
  </div>

  <div class="container-wide legal">
    <p>© {year} {identity.name}. {t.footer.rights}</p>
    <div>
      <a href={href("/faq")}>{t.nav.faq}</a>
      <a href={href("/mentions-legales")}>{t.nav.legal}</a>
      <a href={href("/confidentialite")}>{t.nav.privacy}</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    padding-block: 2rem 1.4rem;
    margin-top: 2rem;
  }
  .bar,
  .contact-row,
  .legal {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 1.4rem;
  }
  .bar {
    justify-content: space-between;
  }
  .brand {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.7rem 1rem;
    min-width: 0;
  }
  .foot-logo {
    display: block;
    height: 36px;
    width: auto;
    max-width: min(160px, 48vw);
    object-fit: contain;
  }
  .name {
    margin: 0;
    font-size: 1.15rem;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.15rem 0.2rem;
  }
  nav a,
  .legal a,
  .contact-row a {
    color: var(--fg-soft);
    text-decoration: none;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    padding-inline: 0.35rem;
  }
  nav a:hover,
  .legal a:hover,
  .contact-row a:hover {
    color: var(--fg);
  }
  .social :global(.socials) {
    margin: 0;
  }
  .contact-row {
    margin-top: 0.6rem;
    color: var(--fg-soft);
    font-size: 0.92rem;
  }
  .contact-row .meta {
    color: var(--mute);
  }
  .legal {
    justify-content: space-between;
    margin-top: 1.1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
    color: var(--mute);
    font-size: 0.92rem;
  }
  .legal p {
    margin: 0;
  }
  .legal div {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 0.8rem;
  }
</style>
