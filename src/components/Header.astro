---
import type { SiteSettings } from "../lib/types";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import ThemeToggle from "./ThemeToggle.astro";
import NavIcon from "./NavIcon.astro";
import { pageI18n } from "../i18n/request";

type Props = { settings: SiteSettings };
const { settings } = Astro.props;
const { locale, path, t, href } = pageI18n(Astro.locals);
const logoSrc = settings.logo || "/images/andreas/logo.webp";
const logoSrcSet = logoSrc.includes("/images/andreas/logo")
  ? "/images/andreas/logo.png 1x, /images/andreas/logo@2x.png 2x"
  : undefined;

const primary = [
  { href: href("/"), label: t.nav.home, match: "/" },
  { href: href("/portfolio"), label: t.nav.portfolio, match: "/portfolio" },
  { href: href("/services"), label: t.nav.services, match: "/services" },
  { href: href("/formations"), label: t.nav.trainings, match: "/formations" },
  { href: href("/lives"), label: t.nav.lives, match: "/lives" },
  { href: href("/a-propos"), label: t.nav.about, match: "/a-propos" },
];

function active(match: string) {
  if (match === "/") return path === "/";
  return path === match || path.startsWith(`${match}/`);
}
---

<header class="site-header">
  <div class="container-wide header-bar">
    <a class="brand" href={href("/")} aria-label={`${settings.name}, ${t.nav.home}`}>
      <img
        class="brand-logo"
        src={logoSrc}
        srcset={logoSrcSet}
        alt=""
        width="175"
        height="96"
        decoding="async"
      />
    </a>

    <nav class="nav-desktop" aria-label={t.a11y.mainNav}>
      {
        primary.map((item) => (
          <a href={item.href} aria-current={active(item.match) ? "page" : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="header-tools">
      <LanguageSwitcher locale={locale} path={path} t={t} variant="desktop" />
      <ThemeToggle variant="header" />
      <a class="btn btn-ember header-cta" href={href("/commander")}>{t.nav.primaryCta} <span class="arrow" aria-hidden="true">→</span></a>
    </div>

    <details class="nav-mobile">
      <summary aria-label={t.nav.openMenu}>
        <span class="burger" aria-hidden="true"></span>
        <span class="sr">Menu</span>
      </summary>
      <button type="button" class="nav-dismiss" data-nav-dismiss aria-label={t.nav.closeMenu} tabindex="-1"></button>
      <div class="sheet">
        {
          primary.map((item) => (
            <a href={item.href} aria-current={active(item.match) ? "page" : undefined}>
              {item.label}
            </a>
          ))
        }
        <a href={href("/consulting")}><NavIcon name="consulting" />{t.nav.consulting}</a>
        <a href={href("/questions")}><NavIcon name="questions" />{t.nav.questions}</a>
        <a href={href("/actualites")}><NavIcon name="news" />{t.nav.news}</a>
        <a href={href("/contact")}><NavIcon name="contact" />{t.nav.contact}</a>
        <a class="btn btn-primary" href={href("/commander")}>{t.nav.primaryCta}</a>
        <ThemeToggle variant="menu" />
        <LanguageSwitcher locale={locale} path={path} t={t} variant="mobile" />
      </div>
    </details>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    border-bottom: 1px solid transparent;
    animation: header-in 520ms var(--ease-standard) both;
    transition:
      background-color var(--motion-normal) var(--ease-standard),
      box-shadow var(--motion-normal) var(--ease-standard),
      border-color var(--motion-normal) var(--ease-standard);
  }
  .site-header.is-scrolled {
    border-bottom-color: var(--line);
    background: color-mix(in srgb, var(--bg) 96%, transparent);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.18);
  }
  :global(html[data-theme="light"]) .site-header.is-scrolled {
    box-shadow: 0 8px 24px rgba(14, 16, 20, 0.08);
  }
  @supports (backdrop-filter: blur(10px)) {
    @media (min-width: 900px) {
      .site-header.is-scrolled {
        backdrop-filter: blur(10px);
      }
    }
  }
  .header-bar {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    min-height: 64px;
    transition: min-height var(--motion-normal) var(--ease-standard);
  }
  .is-scrolled .header-bar {
    min-height: 56px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    color: inherit;
    text-decoration: none;
    min-height: 44px;
    min-width: 0;
    flex: 0 1 auto;
  }
  .brand-logo {
    display: block;
    height: clamp(32px, 8vw, 44px);
    width: auto;
    max-width: min(190px, 62vw);
    object-fit: contain;
    transition: transform var(--motion-fast) var(--ease-standard), opacity var(--motion-fast);
  }
  .brand:hover .brand-logo {
    transform: translateY(-1px);
    opacity: 0.92;
  }
  .nav-desktop {
    display: none;
    margin-left: auto;
    gap: 0.1rem;
  }
  .nav-desktop a {
    color: var(--fg-soft);
    text-decoration: none;
    min-height: 44px;
    padding: 0.5rem 0.65rem;
    display: inline-flex;
    align-items: center;
    position: relative;
    transition: color var(--motion-fast) var(--ease-standard), opacity var(--motion-fast);
  }
  .nav-desktop a:hover {
    color: var(--fg);
    opacity: 0.92;
  }
  .nav-desktop a::after {
    content: "";
    position: absolute;
    left: 0.65rem;
    right: 0.65rem;
    bottom: 0.35rem;
    height: 1px;
    background: var(--color-ember);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--motion-fast) var(--ease-standard);
  }
  .nav-desktop a:hover::after,
  .nav-desktop a[aria-current="page"]::after {
    transform: scaleX(1);
  }
  .nav-desktop a[aria-current="page"] {
    color: var(--fg);
  }
  .header-tools {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin-left: auto;
    flex-shrink: 0;
  }
  .header-cta {
    flex-shrink: 0;
  }
  .nav-mobile {
    position: relative;
    margin-left: 0.15rem;
    flex-shrink: 0;
  }
  .nav-dismiss {
    display: none;
    appearance: none;
    position: fixed;
    inset: 0;
    z-index: 1;
    margin: 0;
    border: 0;
    padding: 0;
    background: rgba(8, 10, 14, 0.46);
    cursor: pointer;
    touch-action: none;
  }
  .nav-mobile[open] .nav-dismiss {
    display: block;
  }
  :global(html[data-theme="light"]) .nav-dismiss {
    background: rgba(14, 16, 20, 0.28);
  }
  :global(html:has(.nav-mobile[open])),
  :global(body:has(.nav-mobile[open])) {
    overflow: hidden;
    overscroll-behavior: none;
  }
  .nav-mobile summary {
    position: relative;
    z-index: 3;
    list-style: none;
    min-height: 44px;
    min-width: 44px;
    display: grid;
    place-items: center;
    cursor: pointer;
    font-weight: 650;
  }
  .nav-mobile summary::-webkit-details-marker {
    display: none;
  }
  .burger {
    width: 18px;
    height: 12px;
    display: block;
    background:
      linear-gradient(var(--fg), var(--fg)) 0 0 / 100% 2px no-repeat,
      linear-gradient(var(--fg), var(--fg)) 0 5px / 70% 2px no-repeat,
      linear-gradient(var(--fg), var(--fg)) 0 10px / 100% 2px no-repeat;
    transition: background-size 220ms var(--ease-standard);
  }
  .nav-mobile[open] .burger {
    background-size: 100% 2px, 100% 2px, 100% 2px;
  }
  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
  .sheet {
    position: fixed;
    top: 4rem;
    right: 0.7rem;
    z-index: 2;
    width: min(18rem, calc(100vw - 1.4rem));
    max-height: calc(100dvh - 4.75rem);
    overflow-x: hidden;
    overflow-y: auto;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
    touch-action: pan-y;
    background: var(--bg-elev);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 0.7rem;
    padding-bottom: max(0.7rem, env(safe-area-inset-bottom));
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    opacity: 0;
    transform: translate3d(0, -8px, 0);
    pointer-events: none;
    transition:
      opacity 240ms var(--ease-standard),
      transform 240ms var(--ease-standard);
  }
  .nav-mobile[open] .sheet {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }
  .sheet > :global(*) {
    flex-shrink: 0;
  }
  .sheet a {
    color: inherit;
    text-decoration: none;
    min-height: 44px;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0 0.6rem;
    border-radius: 8px;
  }
  .sheet a :global(.nav-ico) {
    flex-shrink: 0;
    opacity: 0.82;
    transition:
      opacity var(--motion-fast) var(--ease-standard),
      transform var(--motion-fast) var(--ease-standard);
  }
  .sheet a:hover :global(.nav-ico),
  .sheet a[aria-current="page"] :global(.nav-ico) {
    opacity: 1;
    transform: translateY(-1px);
  }
  .sheet a:hover,
  .sheet a[aria-current="page"] {
    background: rgba(255, 255, 255, 0.05);
  }
  :global(html[data-theme="light"]) .sheet a:hover,
  :global(html[data-theme="light"]) .sheet a[aria-current="page"] {
    background: rgba(14, 16, 20, 0.05);
  }
  @keyframes header-in {
    from {
      opacity: 0;
      transform: translate3d(0, -12px, 0);
    }
  }
  @media (min-width: 980px) {
    .nav-desktop {
      display: flex;
    }
    .header-tools {
      margin-left: 0.45rem;
    }
    .header-cta {
      margin-left: 0.15rem;
    }
    .nav-mobile {
      display: none;
    }
  }
  @media (max-width: 979px) {
    .header-cta .arrow {
      display: none;
    }
    .header-cta {
      padding-inline: 0.75rem;
      font-size: 0.9rem;
    }
  }
  @media (max-width: 420px) {
    .header-bar {
      min-height: 56px;
      gap: 0.45rem;
    }
    .sheet {
      top: 3.55rem;
      max-height: calc(100dvh - 4.2rem);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .site-header,
    .sheet,
    .brand-logo {
      animation: none;
      transition: none;
    }
    .nav-mobile .sheet,
    .nav-mobile[open] .sheet {
      opacity: 1;
      transform: none;
    }
  }
</style>
