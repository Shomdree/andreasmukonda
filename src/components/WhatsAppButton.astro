---
import { pageI18n } from "../i18n/request";
import { whatsappUrl } from "../lib/whatsapp";

type Props = { number: string };
const { t, href } = pageI18n(Astro.locals);
const wa = whatsappUrl(Astro.props.number, t.whatsapp.generic);
---

{
  wa && (
    <div class="dock" role="navigation" aria-label="Actions rapides">
      <a class="btn btn-ghost" href={wa} rel="noopener noreferrer">
        WhatsApp
      </a>
      <a class="btn btn-ember" href={href("/commander")}>
        {t.nav.primaryCta}
      </a>
    </div>
  )
}
{
  !wa && (
    <div class="dock" role="navigation" aria-label="Actions rapides">
      <a class="btn btn-ghost" href={href("/contact")}>
        {t.nav.contact}
      </a>
      <a class="btn btn-ember" href={href("/commander")}>
        {t.nav.primaryCta}
      </a>
    </div>
  )
}

<style>
  .dock {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 30;
    display: flex;
    gap: 0.5rem;
    justify-content: center;
    padding: 0.55rem 0.8rem calc(0.55rem + env(safe-area-inset-bottom));
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    border-top: 1px solid var(--line);
    animation: dock-in 480ms var(--ease-standard) both;
  }
  .dock .btn {
    flex: 1 1 0;
    max-width: 220px;
  }
  @keyframes dock-in {
    from {
      opacity: 0;
      transform: translate3d(0, 16px, 0);
    }
  }
  @media (min-width: 980px) {
    .dock {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .dock {
      animation: none;
    }
  }
</style>
