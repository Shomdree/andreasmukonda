---
import type { PortfolioProject } from "../lib/types";
import ResponsiveImage from "./ResponsiveImage.astro";
import { pageI18n } from "../i18n/request";
import { localizeCategory } from "../i18n/localize";

type Props = { project: PortfolioProject; featured?: boolean; contain?: boolean };
const { project, featured, contain } = Astro.props;
const { t, href } = pageI18n(Astro.locals);
const categoryName = project.category ? localizeCategory(project.category, t).name : t.catalog.project;
---

<a class:list={["card", featured && "featured", contain && "contain"]} href={href(`/portfolio/${project.slug}`)} data-reveal="up">
  <div class="media-frame">
    <ResponsiveImage src={project.coverImage} alt={project.coverAlt} width={800} height={1000} eager={featured} />
  </div>
  <div class="meta">
    <p class="kicker">{categoryName}{project.year ? ` · ${project.year}` : ""}</p>
    <h3 class="display">{project.title}</h3>
    {project.excerpt && <p>{project.excerpt}</p>}
    <span class="more">{t.catalog.viewProject}</span>
  </div>
</a>

<style>
  .card {
    color: inherit;
    text-decoration: none;
    display: grid;
    gap: 0.85rem;
    min-width: 0;
  }
  .media-frame {
    position: relative;
    background: color-mix(in srgb, var(--bg-elev) 80%, #1c2230);
  }
  .card:hover img {
    transform: scale(1.02);
  }
  .card:hover .more {
    color: var(--color-ember);
  }
  .card :global(img) {
    transition: transform 320ms var(--ease-standard);
    height: 100%;
  }
  .contain .media-frame {
    aspect-ratio: 4 / 5;
  }
  .contain :global(img) {
    object-fit: contain;
    background: transparent;
  }
  .featured .media-frame {
    aspect-ratio: 16 / 10;
  }
  h3 {
    font-size: clamp(1.15rem, 2.4vw, 1.55rem);
    margin: 0.2rem 0 0.35rem;
    line-height: 1.15;
    letter-spacing: -0.03em;
    overflow-wrap: anywhere;
  }
  .meta p:last-of-type {
    color: var(--fg-soft);
  }
  .more {
    color: var(--mute);
    font-size: 0.88rem;
    font-weight: 650;
  }
  @media (prefers-reduced-motion: reduce) {
    .card:hover img {
      transform: none;
    }
  }
</style>
