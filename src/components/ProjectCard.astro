---
import type { PortfolioProject } from "../lib/types";
import ResponsiveImage from "./ResponsiveImage.astro";
import { pageI18n } from "../i18n/request";
import { localizeCategory } from "../i18n/localize";

type Props = { project: PortfolioProject; featured?: boolean };
const { project, featured } = Astro.props;
const { t, href } = pageI18n(Astro.locals);
const categoryName = project.category ? localizeCategory(project.category, t).name : t.catalog.project;
---

<a class:list={["card", featured && "featured"]} href={href(`/portfolio/${project.slug}`)} data-reveal="up">
  <div class="media-frame">
    <ResponsiveImage src={project.coverImage} alt={project.coverAlt} width={800} height={1000} />
    <div class="overlay">
      <p class="kicker">{categoryName}</p>
      <h3 class="display">{project.title}</h3>
      <span>{t.catalog.viewProject}</span>
    </div>
  </div>
  <div class="meta">
    <p class="kicker">{categoryName}</p>
    <h3 class="display">{project.title}</h3>
    <p>{project.excerpt}</p>
  </div>
</a>

<style>
  .card {
    color: inherit;
    text-decoration: none;
    display: grid;
    gap: 0.85rem;
  }
  .media-frame {
    position: relative;
  }
  .card:hover img {
    transform: scale(1.03);
  }
  img {
    transition: transform 320ms var(--ease-standard);
    height: 100%;
  }
  .overlay {
    position: absolute;
    inset: auto 0 0;
    padding: 1rem;
    background: linear-gradient(transparent, rgba(8, 10, 14, 0.82));
    opacity: 0;
    transform: translate3d(0, 8px, 0);
    transition: opacity 280ms var(--ease-standard), transform 280ms var(--ease-standard);
  }
  .card:hover .overlay,
  .card:focus-visible .overlay {
    opacity: 1;
    transform: none;
  }
  .featured .media-frame {
    aspect-ratio: 16 / 10;
  }
  h3 {
    font-size: 1.35rem;
    margin: 0.2rem 0 0.35rem;
  }
  .meta p:last-child {
    color: var(--fg-soft);
  }
  @media (max-width: 700px) {
    .overlay {
      display: none;
    }
  }
</style>
