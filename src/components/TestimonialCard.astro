---
import type { Testimonial } from "../lib/types";
type Props = { item: Testimonial };
const { item } = Astro.props;
---

<figure class="quote">
  <blockquote>{item.quote}</blockquote>
  <figcaption>
    <strong>{item.name}</strong>
    <span>{item.role}{item.organization ? ` · ${item.organization}` : ""}</span>
  </figcaption>
</figure>

<style>
  .quote {
    margin: 0;
    padding: 1.4rem 0;
    border-top: 1px solid var(--line);
  }
  blockquote {
    font-family: var(--font-display);
    font-size: 1.35rem;
    line-height: 1.3;
    margin: 0 0 1rem;
  }
  figcaption {
    display: grid;
    color: var(--fg-soft);
    font-size: 0.92rem;
  }
</style>
