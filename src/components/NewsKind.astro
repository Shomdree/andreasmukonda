---
import { newsKindFromCategory, type NewsKind } from "../content/news-kinds";
import { pageI18n } from "../i18n/request";

type Props = { category?: string | null };
const { t } = pageI18n(Astro.locals);
const kind: NewsKind = newsKindFromCategory(Astro.props.category);
const label = t.news.kinds[kind];
---

<p class:list={["news-kind", kind]}>
  <span class="mark" aria-hidden="true">
    {
      kind === "reflexion" ? (
        <svg viewBox="0 0 16 16" fill="none">
          <path d="M3.2 12.2c1.7 0 2.7-1.2 2.7-3.1V3.8H2.2v5.1c0 1.1.5 1.8 1 2.2.4.3.9.5 1.5.5Z" stroke="currentColor" stroke-width="1.4" />
          <path d="M10.1 12.2c1.7 0 2.7-1.2 2.7-3.1V3.8H9.1v5.1c0 1.1.5 1.8 1 2.2.4.3.9.5 1.5.5Z" stroke="currentColor" stroke-width="1.4" />
        </svg>
      ) : kind === "conseil" ? (
        <svg viewBox="0 0 16 16" fill="none">
          <circle cx="8" cy="8" r="5.1" stroke="currentColor" stroke-width="1.4" />
          <path d="M8 4.6v4.1L10.4 10" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      ) : kind === "article" ? (
        <svg viewBox="0 0 16 16" fill="none">
          <rect x="3.2" y="2.6" width="9.6" height="10.8" rx="1.1" stroke="currentColor" stroke-width="1.4" />
          <path d="M5.4 5.6h5.2M5.4 8h5.2M5.4 10.4h3.3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
        </svg>
      ) : (
        <svg viewBox="0 0 16 16" fill="none">
          <circle cx="8" cy="8" r="1.15" fill="currentColor" />
          <circle cx="8" cy="8" r="3.3" stroke="currentColor" stroke-width="1.4" />
          <circle cx="8" cy="8" r="5.4" stroke="currentColor" stroke-width="1.4" />
        </svg>
      )
    }
  </span>
  <span class="label">{label}</span>
</p>

<style>
  .news-kind {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0;
  }
  .mark {
    display: grid;
    place-items: center;
    width: 1.3rem;
    height: 1.3rem;
    color: var(--color-ember);
    border: 1px solid color-mix(in srgb, var(--color-ember) 42%, var(--line));
    flex: 0 0 auto;
  }
  .mark svg {
    width: 0.82rem;
    height: 0.82rem;
    display: block;
  }
  .label {
    color: var(--color-ember);
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-size: 0.72rem;
    font-weight: 700;
  }
</style>
