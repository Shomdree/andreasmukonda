---
import type { PortfolioProject } from "../lib/types";
import ProjectCard from "./ProjectCard.astro";

type Props = { projects: PortfolioProject[]; variant?: "home" | "gallery" };
const { projects, variant = "home" } = Astro.props;
---

<div class:list={["grid", variant]}>
  {
    projects.map((project, i) => (
      <ProjectCard project={project} featured={variant === "home" && i === 0} contain={variant === "gallery"} />
    ))
  }
</div>

<style>
  .grid {
    display: grid;
    gap: 1.6rem;
  }
  @media (min-width: 720px) {
    .home {
      grid-template-columns: 1.2fr 1fr;
    }
    .home > :first-child {
      grid-column: 1 / -1;
    }
    .gallery {
      grid-template-columns: 1fr 1fr;
      gap: 1.8rem 1.2rem;
      align-items: start;
    }
  }
  @media (min-width: 1100px) {
    .home {
      grid-template-columns: 1.15fr 0.85fr 0.85fr;
    }
    .gallery {
      grid-template-columns: 1.1fr 0.9fr 0.9fr;
    }
    .gallery > :nth-child(5n + 1) {
      grid-column: span 1;
    }
  }
</style>
