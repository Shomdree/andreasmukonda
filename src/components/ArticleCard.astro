---
import type { PostItem } from "../lib/types";
import NewsKind from "./NewsKind.astro";
import ResponsiveImage from "./ResponsiveImage.astro";
import { editorialImages } from "../content/news-kinds";
import { pageI18n } from "../i18n/request";

type Props = {
  post: PostItem;
  variant?: "lead" | "secondary" | "list";
  readingTime?: string;
};
const { post, variant = "list", readingTime } = Astro.props;
const { href, locale } = pageI18n(Astro.locals);
const parsed = post.publishedAt ? new Date(post.publishedAt) : null;
const dateOk = Boolean(parsed && !Number.isNaN(parsed.getTime()));
const dateLabel = dateOk && parsed
  ? parsed.toLocaleDateString(locale === "en" ? "en-GB" : "fr-FR", { dateStyle: "long" })
  : "";
const picture = editorialImages(post)[0];
const hrefPost = href(`/actualites/${post.slug}`);
---

<article class:list={["story", variant, picture && "has-media"]} data-reveal="up">
  {
    picture && (
      <a class="visual media-frame" href={hrefPost}>
        <ResponsiveImage
          src={picture.url}
          alt={picture.alt}
          width={960}
          height={640}
          eager={variant === "lead"}
          sizes={variant === "lead" ? "(max-width: 799px) 92vw, 720px" : "(max-width: 799px) 92vw, 360px"}
        />
      </a>
    )
  }
  <div class="copy">
    <NewsKind category={post.category} />
    <h3 class="display">
      <a href={hrefPost}>{post.title}</a>
    </h3>
    {post.excerpt && <p>{post.excerpt}</p>}
    <p class="meta">
      {dateOk && <time datetime={post.publishedAt}>{dateLabel}</time>}
      {readingTime && <span>{readingTime}</span>}
    </p>
  </div>
</article>

<style>
  .story {
    min-width: 0;
  }
  .has-media {
    display: grid;
    gap: 1rem;
  }
  .visual {
    display: block;
    aspect-ratio: 16 / 10;
  }
  .visual :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  h3 {
    font-size: clamp(1.25rem, 3vw, 1.85rem);
    margin: 0.3rem 0 0.45rem;
    line-height: 1.12;
    overflow-wrap: anywhere;
  }
  .lead h3 {
    font-size: clamp(1.7rem, 5vw, 3rem);
  }
  a {
    color: inherit;
    text-decoration: none;
  }
  a:hover {
    color: var(--color-ember);
  }
  p {
    color: var(--fg-soft);
    margin: 0;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.8rem;
    color: var(--mute);
    font-size: 0.86rem;
    margin-top: 0.55rem;
  }
  .secondary,
  .lead {
    padding-bottom: 1.2rem;
  }
  .list {
    padding: 1.1rem 0;
    border-top: 1px solid var(--line);
  }
  @media (min-width: 800px) {
    .lead.has-media,
    .list.has-media {
      grid-template-columns: minmax(11rem, 18rem) 1fr;
      align-items: start;
      gap: 1.4rem 1.8rem;
    }
    .lead.has-media {
      grid-template-columns: minmax(16rem, 28rem) 1fr;
    }
  }
</style>
