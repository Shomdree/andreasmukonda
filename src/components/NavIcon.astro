---
type IconName = "contact" | "consulting" | "questions" | "news";
type Props = { name: IconName };
const { name } = Astro.props;
---

<svg class="nav-ico" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === "contact" && (
    <>
      <rect x="3.5" y="5.5" width="17" height="13" rx="2"></rect>
      <path d="m4 7 8 6 8-6"></path>
    </>
  )}
  {name === "consulting" && (
    <>
      <rect x="3.5" y="8" width="17" height="12" rx="2"></rect>
      <path d="M8 8V6.8A2.8 2.8 0 0 1 10.8 4h2.4A2.8 2.8 0 0 1 16 6.8V8M3.5 13h17"></path>
    </>
  )}
  {name === "questions" && (
    <>
      <circle cx="12" cy="12" r="8.2"></circle>
      <path d="M9.6 9.4a2.4 2.4 0 1 1 3.3 2.2c-.7.4-1.1.8-1.1 1.6"></path>
      <path d="M12 17.1h.01"></path>
    </>
  )}
  {name === "news" && (
    <>
      <path d="M5 5.5h10.5A1.5 1.5 0 0 1 17 7v12.5H6.5A1.5 1.5 0 0 1 5 18V5.5Z"></path>
      <path d="M17 9.5h1.5A1.5 1.5 0 0 1 20 11v7a1.5 1.5 0 0 1-1.5 1.5H17"></path>
      <path d="M8 9h6M8 12.5h6M8 16h3.5"></path>
    </>
  )}
</svg>
