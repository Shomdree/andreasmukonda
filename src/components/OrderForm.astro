---
import { budgetRanges } from "../content/defaults";
import type { ServiceItem, TrainingItem } from "../lib/types";
import {
  DESIGN_KINDS,
  DESIGN_ORIGINS,
  DESIGN_STYLES,
  WEB_CONTENT,
  WEB_EXISTS,
  WEB_FEATURES_SIMPLE,
  WEB_TYPES,
  TRAINING_AUDIENCES,
  TRAINING_FORMATS,
  TRAINING_LEVELS,
  CONSULTING_NEEDS,
  MEDIA_KINDS,
  designKindFromService,
  isPrintService,
  orderKindFromService,
  selectedList,
} from "../lib/order-context";
import FormGuard from "./FormGuard.astro";
import { pageI18n } from "../i18n/request";
import { localizeBudget, localizeService, localizeTraining } from "../i18n/localize";

type Props = {
  action: string;
  services: ServiceItem[];
  trainings?: TrainingItem[];
  selectedSlug?: string | null;
  selectedTraining?: string | null;
  errors?: Record<string, string>;
  values?: Record<string, string>;
};
const { t, locale } = pageI18n(Astro.locals);
const e = Astro.props.errors ?? {};
const v = Astro.props.values ?? {};
const services = Astro.props.services.map((item) => localizeService(item, t));
const trainings = (Astro.props.trainings ?? []).map((item) => localizeTraining(item, t));
const mainServices = services.filter((item) => !isPrintService(item));
const printServices = services.filter((item) => isPrintService(item));
const selected = v.serviceId || services.find((s) => s.slug === Astro.props.selectedSlug)?.id;
const selectedService = services.find((s) => s.id === selected);
const presetDesignKind = v.designKind || designKindFromService(selectedService);
const selectedTraining = v.trainingPick || Astro.props.selectedTraining || "";
const features = selectedList(v.webFeatures);
const lab = (map: Record<string, string>, key: string) => map[key] ?? key;
const designKinds = t.order.designKinds as Record<string, string>;
const designOrigins = t.order.designOrigins as Record<string, string>;
const designStyles = t.order.designStyles as Record<string, string>;
const webTypes = t.order.webTypes as Record<string, string>;
const webExists = t.order.webExistsOptions as Record<string, string>;
const webFeatureOptions = t.order.webFeatureOptions as Record<string, string>;
const webContent = t.order.webContentOptions as Record<string, string>;
const trainingSpecial = t.order.trainingSpecial as Record<string, string>;
const trainingLevels = t.order.trainingLevels as Record<string, string>;
const trainingFormats = t.order.trainingFormats as Record<string, string>;
const trainingAudiences = t.order.trainingAudiences as Record<string, string>;
const consultingNeeds = t.order.consultingNeeds as Record<string, string>;
const mediaKinds = t.order.mediaKinds as Record<string, string>;
---

<form class="stack js-form js-order" method="post" action={Astro.props.action} enctype="multipart/form-data" novalidate data-astro-reload>
  {e.form && <p class="banner" role="alert">{e.form}</p>}
  <FormGuard />
  <input type="hidden" name="locale" value={locale} />
  <input type="hidden" name="serviceTitle" id="serviceTitle" value={v.serviceTitle ?? ""} />

  <ol class="progress" data-progress>
    {t.order.formSteps.map((step, index) => (
      <li data-progress-step={index}>{step}</li>
    ))}
  </ol>

  <fieldset data-step="0">
    <legend>1. {t.form.service}</legend>
    <div class="field">
      <label for="serviceId">{t.form.service}</label>
      <select id="serviceId" name="serviceId" required>
        <option value="">{t.form.choose}</option>
        <optgroup label={t.order.serviceGroupMain}>
          {
            mainServices.map((s) => (
              <option value={s.id} selected={selected === s.id} data-title={s.title} data-kind={orderKindFromService(s)} data-design-kind={designKindFromService(s)}>
                {s.title}
              </option>
            ))
          }
        </optgroup>
        {
          printServices.length > 0 && (
            <optgroup label={t.servicesPage.printTitle}>
              {printServices.map((s) => (
                <option value={s.id} selected={selected === s.id} data-title={s.title} data-kind={orderKindFromService(s)} data-design-kind={designKindFromService(s)}>
                  {s.title}
                </option>
              ))}
            </optgroup>
          )
        }
      </select>
      {e.serviceId && <p class="error">{e.serviceId}</p>}
      <p class="error" data-service-hint hidden>{t.form.errors.service}</p>
    </div>
  </fieldset>

  <fieldset data-step="1">
    <legend>2. {t.order.formSteps[1]}</legend>
    <p class="hint">
      <button type="button" class="text-btn" data-change-service>{t.order.changeService}</button>
    </p>
    <p class="hint" data-picked-service data-picked-label={t.order.pickedService} hidden></p>

    <div data-kind-panel="design">
      <div class="field">
        <label for="designKind">{t.order.designKind}</label>
        <select id="designKind" name="designKind">
          <option value="">{t.form.choose}</option>
          {DESIGN_KINDS.map((key) => (
            <option value={key} selected={presetDesignKind === key}>{lab(designKinds, key)}</option>
          ))}
        </select>
        {e.designKind && <p class="error">{e.designKind}</p>}
      </div>
      <div class="field" data-when-name="designKind" data-when-is="autre">
        <label for="designKindOther">{t.order.otherPrecision}</label>
        <input id="designKindOther" name="designKindOther" maxlength="80" value={v.designKindOther ?? ""} />
        {e.designKindOther && <p class="error">{e.designKindOther}</p>}
      </div>
      <div class="field">
        <label for="displayName">{t.order.displayName}</label>
        <input id="displayName" name="displayName" maxlength="120" value={v.displayName ?? ""} />
        {e.displayName && <p class="error">{e.displayName}</p>}
      </div>
      <div class="field">
        <label for="designText">{t.order.designText} <span class="opt">({t.form.optional})</span></label>
        <input id="designText" name="designText" maxlength="500" value={v.designText ?? ""} />
      </div>
      <div class="field">
        <label for="designOrigin">{t.order.designOrigin}</label>
        <select id="designOrigin" name="designOrigin">
          <option value="">{t.form.choose}</option>
          {DESIGN_ORIGINS.map((key) => (
            <option value={key} selected={v.designOrigin === key}>{lab(designOrigins, key)}</option>
          ))}
        </select>
        {e.designOrigin && <p class="error">{e.designOrigin}</p>}
      </div>
      <div class="field">
        <label for="designColors">{t.order.designColors} <span class="opt">({t.form.optional})</span></label>
        <input id="designColors" name="designColors" maxlength="200" value={v.designColors ?? ""} />
      </div>
      <div class="field">
        <label for="designStyle">{t.order.designStyle} <span class="opt">({t.form.optional})</span></label>
        <select id="designStyle" name="designStyle">
          <option value="">{t.form.choose}</option>
          {DESIGN_STYLES.map((key) => (
            <option value={key} selected={v.designStyle === key}>{lab(designStyles, key)}</option>
          ))}
        </select>
      </div>
      <div class="field" data-when-name="designStyle" data-when-is="autre">
        <label for="designStyleOther">{t.order.otherPrecision}</label>
        <input id="designStyleOther" name="designStyleOther" maxlength="80" value={v.designStyleOther ?? ""} />
      </div>
      <div class="field" data-when-name="designKind" data-when-in="affiche,flyer,carte,badge,bache,tshirt,print,autre">
        <label for="designFormat">{t.order.designFormat}</label>
        <input id="designFormat" name="designFormat" maxlength="80" value={v.designFormat ?? ""} />
        {e.designFormat && <p class="error">{e.designFormat}</p>}
      </div>
    </div>

    <div data-kind-panel="print">
      <div class="field">
        <label for="printQuantity">{t.order.printQuantity}</label>
        <input id="printQuantity" name="printQuantity" inputmode="numeric" maxlength="20" value={v.printQuantity ?? ""} />
        {e.printQuantity && <p class="error">{e.printQuantity}</p>}
      </div>
      <div class="field">
        <label for="printText" data-print-text-label data-label-default={t.order.printText} data-label-names={t.order.printTextNames}>
          <span data-print-text-copy>{t.order.printText}</span>
          <span class="opt">({t.form.optional})</span>
        </label>
        <input id="printText" name="printText" maxlength="500" value={v.printText ?? ""} />
      </div>
      <div class="field">
        <label for="printFormat" data-print-format-label data-label-default={t.order.printFormat} data-label-apparel={t.order.printFormatApparel}>
          <span data-print-format-copy>{t.order.printFormat}</span>
          <span class="opt" data-print-format-opt>({t.form.optional})</span>
        </label>
        <input id="printFormat" name="printFormat" maxlength="80" value={v.printFormat ?? ""} />
      </div>
      <div class="field">
        <label for="printColors">{t.order.printColors} <span class="opt">({t.form.optional})</span></label>
        <input id="printColors" name="printColors" maxlength="200" value={v.printColors ?? ""} />
      </div>
    </div>

    <div data-kind-panel="web">
      <div class="field">
        <label for="webType">{t.order.webType}</label>
        <select id="webType" name="webType">
          <option value="">{t.form.choose}</option>
          {WEB_TYPES.map((key) => (
            <option value={key} selected={v.webType === key}>{lab(webTypes, key)}</option>
          ))}
        </select>
        {e.webType && <p class="error">{e.webType}</p>}
      </div>
      <div class="field" data-when-name="webType" data-when-is="autre">
        <label for="webTypeOther">{t.order.otherPrecision}</label>
        <input id="webTypeOther" name="webTypeOther" maxlength="80" value={v.webTypeOther ?? ""} />
        {e.webTypeOther && <p class="error">{e.webTypeOther}</p>}
      </div>
      <div class="field">
        <label for="webExists">{t.order.webExists}</label>
        <select id="webExists" name="webExists">
          <option value="">{t.form.choose}</option>
          {WEB_EXISTS.map((key) => (
            <option value={key} selected={v.webExists === key}>{lab(webExists, key)}</option>
          ))}
        </select>
        {e.webExists && <p class="error">{e.webExists}</p>}
      </div>
      <div class="field" data-when-name="webExists" data-when-in="ameliorer,refaire">
        <label for="webUrl">{t.order.webUrl} <span class="opt">({t.form.optional})</span></label>
        <input id="webUrl" name="webUrl" maxlength="200" value={v.webUrl ?? ""} inputmode="url" />
      </div>
      <fieldset class="inner">
        <legend>{t.order.webFeatures}</legend>
        <div class="checks">
          {WEB_FEATURES_SIMPLE.map((key) => (
            <label class="check">
              <input type="checkbox" name="webFeatures" value={key} checked={features.includes(key) ? true : undefined} />
              {lab(webFeatureOptions, key)}
            </label>
          ))}
        </div>
        {e.webFeatures && <p class="error">{e.webFeatures}</p>}
      </fieldset>
      <div class="field" data-when-name="webFeatures" data-when-includes="autre">
        <label for="webFeatureOther">{t.order.otherPrecision}</label>
        <input id="webFeatureOther" name="webFeatureOther" maxlength="80" value={v.webFeatureOther ?? ""} />
      </div>
      <div class="field">
        <label for="webContent">{t.order.webContent}</label>
        <select id="webContent" name="webContent">
          <option value="">{t.form.choose}</option>
          {WEB_CONTENT.map((key) => (
            <option value={key} selected={v.webContent === key}>{lab(webContent, key)}</option>
          ))}
        </select>
        {e.webContent && <p class="error">{e.webContent}</p>}
      </div>
    </div>

    <div data-kind-panel="training">
      <div class="field">
        <label for="trainingPick">{t.order.trainingPick}</label>
        <select id="trainingPick" name="trainingPick">
          <option value="">{t.form.choose}</option>
          {trainings.map((item) => (
            <option value={item.id} selected={selectedTraining === item.id || selectedTraining === item.slug}>{item.title}</option>
          ))}
          <option value="autre" selected={v.trainingPick === "autre"}>{trainingSpecial.autre}</option>
          <option value="unsure" selected={v.trainingPick === "unsure"}>{trainingSpecial.unsure}</option>
        </select>
        {e.trainingPick && <p class="error">{e.trainingPick}</p>}
      </div>
      <div class="field" data-when-name="trainingPick" data-when-is="autre">
        <label for="trainingOther">{t.order.otherPrecision}</label>
        <input id="trainingOther" name="trainingOther" maxlength="120" value={v.trainingOther ?? ""} />
        {e.trainingOther && <p class="error">{e.trainingOther}</p>}
      </div>
      <div class="field">
        <label for="trainingLevel">{t.order.trainingLevel}</label>
        <select id="trainingLevel" name="trainingLevel">
          <option value="">{t.form.choose}</option>
          {TRAINING_LEVELS.map((key) => (
            <option value={key} selected={v.trainingLevel === key}>{lab(trainingLevels, key)}</option>
          ))}
        </select>
        {e.trainingLevel && <p class="error">{e.trainingLevel}</p>}
      </div>
      <div class="field">
        <label for="trainingFormat">{t.order.trainingFormat}</label>
        <select id="trainingFormat" name="trainingFormat">
          <option value="">{t.form.choose}</option>
          {TRAINING_FORMATS.map((key) => (
            <option value={key} selected={v.trainingFormat === key}>{lab(trainingFormats, key)}</option>
          ))}
        </select>
        {e.trainingFormat && <p class="error">{e.trainingFormat}</p>}
      </div>
      <div class="field">
        <label for="trainingAudience">{t.order.trainingAudience}</label>
        <select id="trainingAudience" name="trainingAudience">
          <option value="">{t.form.choose}</option>
          {TRAINING_AUDIENCES.map((key) => (
            <option value={key} selected={v.trainingAudience === key}>{lab(trainingAudiences, key)}</option>
          ))}
        </select>
        {e.trainingAudience && <p class="error">{e.trainingAudience}</p>}
      </div>
      <div class="field" data-when-name="trainingAudience" data-when-in="groupe,organisation">
        <label for="trainingParticipants">{t.order.trainingParticipants}</label>
        <input id="trainingParticipants" name="trainingParticipants" inputmode="numeric" maxlength="20" value={v.trainingParticipants ?? ""} />
        {e.trainingParticipants && <p class="error">{e.trainingParticipants}</p>}
      </div>
      <div class="field">
        <label for="trainingAvailability">{t.order.trainingWhen} <span class="opt">({t.form.optional})</span></label>
        <textarea id="trainingAvailability" name="trainingAvailability" maxlength="400">{v.trainingAvailability ?? ""}</textarea>
      </div>
    </div>

    <div data-kind-panel="consulting">
      <div class="field">
        <label for="consultingNeed">{t.order.consultingNeed}</label>
        <select id="consultingNeed" name="consultingNeed">
          <option value="">{t.form.choose}</option>
          {CONSULTING_NEEDS.map((key) => (
            <option value={key} selected={v.consultingNeed === key}>{lab(consultingNeeds, key)}</option>
          ))}
        </select>
        {e.consultingNeed && <p class="error">{e.consultingNeed}</p>}
      </div>
    </div>

    <div data-kind-panel="media">
      <div class="field">
        <label for="mediaKind">{t.order.mediaKind}</label>
        <select id="mediaKind" name="mediaKind">
          <option value="">{t.form.choose}</option>
          {MEDIA_KINDS.map((key) => (
            <option value={key} selected={v.mediaKind === key}>{lab(mediaKinds, key)}</option>
          ))}
        </select>
        {e.mediaKind && <p class="error">{e.mediaKind}</p>}
      </div>
      <div class="field">
        <label for="mediaDate">{t.order.mediaDate} <span class="opt">({t.form.optional})</span></label>
        <input id="mediaDate" name="mediaDate" maxlength="80" value={v.mediaDate ?? ""} />
      </div>
      <div class="field">
        <label for="mediaPlace">{t.order.mediaPlace} <span class="opt">({t.form.optional})</span></label>
        <input id="mediaPlace" name="mediaPlace" maxlength="120" value={v.mediaPlace ?? ""} />
      </div>
    </div>

    <div data-kind-panel="generic">
      <div class="field">
        <label for="projectType">{t.form.projectType}</label>
        <input id="projectType" name="projectType" maxlength="80" value={v.projectType ?? ""} />
        {e.projectType && <p class="error">{e.projectType}</p>}
      </div>
    </div>

    <div class="field">
      <label for="description" data-description-label data-label-default={t.order.details} data-label-consulting={t.order.consultingExplain} data-label-media={t.order.mediaCover}>
        <span data-desc-text>{t.order.details}</span>
        <span class="opt" data-desc-optional>({t.form.optional})</span>
      </label>
      <textarea id="description" name="description" maxlength="5000">{v.description ?? ""}</textarea>
      {e.description && <p class="error">{e.description}</p>}
    </div>

    <div class="field" data-for-kind="design web generic print media">
      <label for="attachment">{t.form.attachment}</label>
      <p class="hint" data-for-kind="design">{t.order.designAttachment}</p>
      <p class="hint" data-for-kind="print">{t.order.printHint}</p>
      <p class="hint" data-for-kind="web generic media">{t.form.attachmentHint}</p>
      <div class="file-wrap">
        <input id="attachment" name="attachment" type="file" accept=".pdf,.jpg,.jpeg,.png,.webp,.avif,application/pdf,image/jpeg,image/png,image/webp,image/avif" data-no-file={t.form.noFile} />
        <label class="file-ui" for="attachment">
          <span class="file-cta">{t.form.chooseFile}</span>
          <span class="file-name" data-file-name>{t.form.noFile}</span>
        </label>
      </div>
    </div>
  </fieldset>

  <fieldset data-step="2">
    <legend>3. {t.order.formSteps[2]}</legend>
    <div class="field">
      <label for="fullName">{t.form.name}</label>
      <input id="fullName" name="fullName" required maxlength="80" value={v.fullName ?? ""} autocomplete="name" />
      {e.fullName && <p class="error">{e.fullName}</p>}
    </div>
    <div class="field">
      <label for="organization">{t.form.organizationOptional}</label>
      <input id="organization" name="organization" maxlength="120" value={v.organization ?? ""} />
    </div>
    <div class="field">
      <label for="email">{t.form.email}</label>
      <input id="email" name="email" type="email" required maxlength="120" value={v.email ?? ""} autocomplete="email" />
      {e.email && <p class="error">{e.email}</p>}
    </div>
    <div class="field">
      <label for="phone">{t.form.phone}</label>
      <input id="phone" name="phone" type="tel" required inputmode="tel" maxlength="30" value={v.phone ?? ""} autocomplete="tel" />
      {e.phone && <p class="error">{e.phone}</p>}
    </div>
    <div class="field">
      <label for="whatsapp">WhatsApp <span class="opt">({t.form.optional})</span></label>
      <input id="whatsapp" name="whatsapp" type="tel" inputmode="tel" maxlength="30" value={v.whatsapp ?? ""} />
    </div>
    <div class="field">
      <label for="contactPreference">{t.form.contactPreference}</label>
      <select id="contactPreference" name="contactPreference">
        <option value="whatsapp">WhatsApp</option>
        <option value="email" selected={v.contactPreference === "email"}>{t.form.email}</option>
        <option value="telephone" selected={v.contactPreference === "telephone"}>{t.form.phone}</option>
      </select>
    </div>
    <div class="field" data-for-kind="web generic design print">
      <label for="desiredDeadline">{t.form.deadline} <span class="opt">({t.form.optional})</span></label>
      <input id="desiredDeadline" name="desiredDeadline" maxlength="80" value={v.desiredDeadline ?? ""} />
    </div>
    <div class="field" data-for-kind="web generic design print media">
      <p class="hint">{t.form.budgetHint}</p>
      <label for="budgetRange">{t.form.budget}</label>
      <select id="budgetRange" name="budgetRange">
        {budgetRanges.map((b) => <option value={b} selected={v.budgetRange === b}>{localizeBudget(b, t)}</option>)}
      </select>
    </div>
  </fieldset>

  <fieldset data-step="3">
    <legend>4. {t.order.reviewTitle}</legend>
    <div class="review" data-review>
      <p class="hint">{t.order.reviewTitle}</p>
    </div>
    <label class="check">
      <input type="checkbox" name="consent" required />
      {t.form.consentOrder}
    </label>
    {e.consent && <p class="error">{e.consent}</p>}
  </fieldset>

  <div class="wizard-nav">
    <button class="btn btn-ghost" type="button" data-back>{t.order.back}</button>
    <button class="btn btn-primary" type="button" data-next>{t.order.next}</button>
    <button class="btn btn-primary" type="submit" data-submit data-loading-label={t.form.sending}>{t.order.cta}</button>
  </div>
</form>

<script>
  const form = document.querySelector<HTMLFormElement>("form.js-order");
  if (form) {
    const steps = [...form.querySelectorAll<HTMLElement>("[data-step]")];
    const nextBtn = form.querySelector<HTMLButtonElement>("[data-next]");
    const backBtn = form.querySelector<HTMLButtonElement>("[data-back]");
    const submitBtn = form.querySelector<HTMLButtonElement>("[data-submit]");
    const select = form.querySelector<HTMLSelectElement>("#serviceId");
    const hiddenTitle = form.querySelector<HTMLInputElement>("#serviceTitle");
    const review = form.querySelector("[data-review]");
    const hint = form.querySelector<HTMLElement>("[data-service-hint]");
    const file = form.querySelector<HTMLInputElement>("#attachment");
    const fileName = form.querySelector("[data-file-name]");
    const escapeHtml = (value: string) =>
      value.replace(/[&<>"']/g, (ch) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[ch] || ch));
    const errorStep = form.querySelector(".error:not([data-service-hint])")?.closest<HTMLElement>("[data-step]");
    let current = errorStep ? Number(errorStep.dataset.step || 0) : select?.value ? 1 : 0;

    const kindOf = () => select?.selectedOptions[0]?.dataset.kind || "generic";

    const visible = (node: Element) => {
      const el = node as HTMLElement;
      if (el.hidden) return false;
      if (el.closest("[hidden]")) return false;
      return true;
    };

    const printKindOf = () => select?.selectedOptions[0]?.dataset.designKind || "";

    const syncTitle = () => {
      const option = select?.selectedOptions[0];
      const title = option?.dataset.title || option?.text.trim() || "";
      if (hiddenTitle && option) hiddenTitle.value = title;
      const picked = form.querySelector<HTMLElement>("[data-picked-service]");
      if (picked) {
        const label = picked.dataset.pickedLabel || "";
        picked.textContent = title && option?.value ? `${label} : ${title}` : "";
        picked.hidden = !option?.value;
      }
    };

    const applyPrintLabels = () => {
      const printKind = printKindOf();
      const textLabel = form.querySelector<HTMLElement>("[data-print-text-label]");
      const textCopy = form.querySelector<HTMLElement>("[data-print-text-copy]");
      const formatLabel = form.querySelector<HTMLElement>("[data-print-format-label]");
      const formatCopy = form.querySelector<HTMLElement>("[data-print-format-copy]");
      const formatOpt = form.querySelector<HTMLElement>("[data-print-format-opt]");
      if (textLabel && textCopy) {
        const names = printKind === "badge" || printKind === "carte";
        textCopy.textContent = (names ? textLabel.dataset.labelNames : textLabel.dataset.labelDefault) || "";
      }
      if (formatLabel && formatCopy) {
        formatCopy.textContent = (printKind === "tshirt" ? formatLabel.dataset.labelApparel : formatLabel.dataset.labelDefault) || "";
      }
      if (formatOpt) formatOpt.hidden = printKind === "affiche" || printKind === "bache";
    };

    const applyDesignPreset = (force = false) => {
      const designSelect = form.querySelector<HTMLSelectElement>("#designKind");
      const preset = select?.selectedOptions[0]?.dataset.designKind || "";
      if (designSelect && preset && (force || !designSelect.value)) designSelect.value = preset;
    };

    const applyWhen = () => {
      form.querySelectorAll<HTMLElement>("[data-when-name]").forEach((node) => {
        const name = node.dataset.whenName || "";
        const named = form.querySelectorAll<HTMLInputElement | HTMLSelectElement>(`[name="${name}"]`);
        let value = "";
        named.forEach((input) => {
          if (input instanceof HTMLInputElement && input.type === "checkbox") {
            if (input.checked) value = value ? `${value},${input.value}` : input.value;
          } else if (visible(input) || input instanceof HTMLSelectElement) {
            value = input.value;
          }
        });
        const is = node.dataset.whenIs;
        const includes = node.dataset.whenIncludes;
        const list = (node.dataset.whenIn || "").split(",").filter(Boolean);
        let show = true;
        if (is) show = value === is;
        if (includes) show = value.split(",").includes(includes);
        if (list.length) show = list.includes(value);
        node.hidden = !show;
      });
    };

    const applyKind = () => {
      const kind = kindOf();
      form.querySelectorAll<HTMLElement>("[data-kind-panel]").forEach((panel) => {
        panel.hidden = panel.dataset.kindPanel !== kind;
      });
      form.querySelectorAll<HTMLElement>("[data-for-kind]").forEach((node) => {
        const allowed = (node.dataset.forKind || "").split(/\s+/).filter(Boolean);
        node.hidden = allowed.length > 0 && !allowed.includes(kind);
      });
      const descLabel = form.querySelector<HTMLElement>("[data-description-label]");
      const descText = form.querySelector<HTMLElement>("[data-desc-text]");
      const descOptional = form.querySelector<HTMLElement>("[data-desc-optional]");
      if (descLabel && descText) {
        descText.textContent =
          (kind === "consulting" ? descLabel.dataset.labelConsulting : kind === "media" ? descLabel.dataset.labelMedia : descLabel.dataset.labelDefault) ||
          descLabel.dataset.labelDefault ||
          "";
      }
      if (descOptional) descOptional.hidden = kind === "consulting" || kind === "generic";
      applyPrintLabels();
      applyWhen();
      form.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>("input, select, textarea").forEach((input) => {
        if (["locale", "website", "startedAt", "serviceTitle", "serviceId"].includes(input.name)) {
          input.disabled = false;
          return;
        }
        const gated = input.closest<HTMLElement>("[data-kind-panel], [data-when-name], [data-for-kind]");
        input.disabled = Boolean(gated?.hidden);
      });
    };

    const paintProgress = () => {
      form.querySelectorAll<HTMLElement>("[data-progress-step]").forEach((item) => {
        const index = Number(item.dataset.progressStep || 0);
        item.classList.toggle("is-current", index === current);
        item.classList.toggle("is-done", index < current);
      });
    };

    const showStep = (index: number) => {
      current = Math.max(0, Math.min(index, steps.length - 1));
      steps.forEach((step, i) => {
        step.hidden = i !== current;
      });
      if (backBtn) backBtn.hidden = current === 0;
      if (nextBtn) nextBtn.hidden = current === steps.length - 1;
      if (submitBtn) submitBtn.hidden = current !== steps.length - 1;
      paintProgress();
      applyKind();
      if (current === steps.length - 1) fillReview();
      steps[current]?.scrollIntoView({ block: "nearest" });
    };

    const stepInvalid = () => {
      const step = steps[current];
      if (!step) return false;
      if (current === 0 && !select?.value) {
        select?.focus();
        if (hint) hint.hidden = false;
        return true;
      }
      if (hint) hint.hidden = true;
      const fields = [...step.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>("input, select, textarea")];
      for (const field of fields) {
        if (field.disabled || !visible(field)) continue;
        if (field instanceof HTMLInputElement && field.type === "checkbox") continue;
        const required =
          field.required ||
          field.matches(
            "#designKind, #displayName, #designOrigin, #webType, #webExists, #webContent, #trainingPick, #trainingLevel, #trainingFormat, #trainingAudience, #printQuantity, #consultingNeed, #mediaKind, #projectType",
          ) ||
          ((kindOf() === "generic" || kindOf() === "consulting") && field.id === "description") ||
          (kindOf() === "print" && (printKindOf() === "affiche" || printKindOf() === "bache") && field.id === "printFormat");
        if (required && !String(field.value || "").trim()) {
          field.focus();
          return true;
        }
      }
      return false;
    };

    const fillReview = () => {
      if (!review) return;
      const rows: string[] = [];
      const push = (label: string, value: string) => {
        if (!value.trim()) return;
        rows.push(`<div><dt>${escapeHtml(label)}</dt><dd>${escapeHtml(value)}</dd></div>`);
      };
      const optionLabel = (id: string) => {
        const field = form.querySelector<HTMLSelectElement>(`#${id}`);
        if (!field || field.disabled) return "";
        return field.selectedOptions[0]?.text.trim() || "";
      };
      const val = (id: string) => {
        const field = form.querySelector<HTMLInputElement | HTMLTextAreaElement>(`#${id}`);
        if (!field || field.disabled) return "";
        return field.value.trim();
      };
      const visibleLabel = (id: string) =>
        [...form.querySelectorAll<HTMLLabelElement>(`label[for="${id}"]`)].find((node) => visible(node))?.textContent || "";
      push(form.querySelector("label[for=serviceId]")?.textContent || "Service", select?.selectedOptions[0]?.text.trim() || "");
      push(visibleLabel("designKind"), optionLabel("designKind"));
      push(visibleLabel("displayName"), val("displayName"));
      push(visibleLabel("printQuantity"), val("printQuantity"));
      push(visibleLabel("printText"), val("printText"));
      push(visibleLabel("webType"), optionLabel("webType"));
      push(visibleLabel("trainingPick"), optionLabel("trainingPick"));
      push(visibleLabel("consultingNeed"), optionLabel("consultingNeed"));
      push(visibleLabel("mediaKind"), optionLabel("mediaKind"));
      push(visibleLabel("mediaDate"), val("mediaDate"));
      push(visibleLabel("projectType"), val("projectType"));
      push(visibleLabel("fullName"), val("fullName"));
      push(visibleLabel("desiredDeadline"), val("desiredDeadline"));
      push(visibleLabel("budgetRange"), optionLabel("budgetRange"));
      push(visibleLabel("description"), val("description"));
      review.innerHTML = `<dl>${rows.join("")}</dl>`;
    };

    nextBtn?.addEventListener("click", () => {
      if (stepInvalid()) return;
      showStep(current + 1);
    });
    backBtn?.addEventListener("click", () => showStep(current - 1));
    form.querySelector("[data-change-service]")?.addEventListener("click", () => showStep(0));
    select?.addEventListener("change", () => {
      syncTitle();
      applyDesignPreset(true);
      applyKind();
    });
    form.addEventListener("change", applyWhen);
    file?.addEventListener("change", () => {
      if (!fileName) return;
      fileName.textContent = file.files?.[0]?.name || file.dataset.noFile || "";
    });

    syncTitle();
    applyDesignPreset();
    showStep(current);
  }
</script>

<style>
  .stack { display: grid; gap: 1.2rem; max-width: 40rem; }
  [hidden] { display: none !important; }
  fieldset { border: 1px solid var(--line); padding: 1rem; display: grid; gap: 0.9rem; border-radius: 14px; }
  fieldset.inner { padding: 0.8rem; }
  legend { padding: 0 0.4rem; color: var(--color-ember); }
  .banner { color: var(--color-danger); }
  .check { display: flex; gap: 0.6rem; color: var(--fg-soft); font-size: 0.92rem; align-items: flex-start; }
  .checks { display: grid; gap: 0.55rem; }
  .hint { color: var(--mute); font-size: 0.9rem; margin: 0; }
  .opt { color: var(--mute); font-weight: 400; }
  .text-btn {
    appearance: none;
    background: none;
    border: 0;
    padding: 0.3rem 0;
    min-height: 44px;
    color: var(--color-ember);
    cursor: pointer;
    font: inherit;
  }
  .progress {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.8rem;
    list-style: none;
    padding: 0;
    margin: 0 0 0.4rem;
    color: var(--mute);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .progress .is-current { color: var(--fg); font-weight: 700; }
  .progress .is-done { color: var(--fg-soft); }
  .wizard-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
  }
  .wizard-nav .btn { min-height: 44px; }
  .review dl { display: grid; gap: 0.55rem; margin: 0; }
  .review dt { color: var(--mute); font-size: 0.8rem; }
  .review dd { margin: 0; color: var(--fg-soft); white-space: pre-wrap; }
  .file-wrap { position: relative; }
  .file-wrap input[type="file"] {
    position: absolute;
    inset: 0;
    opacity: 0;
    width: 100%;
    height: 100%;
    cursor: pointer;
  }
  .file-ui {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.7rem;
    min-height: 44px;
    padding: 0.55rem 0.85rem;
    border: 1px solid var(--line);
    border-radius: 10px;
    color: var(--fg-soft);
  }
  .file-cta { color: var(--fg); font-weight: 650; }
  .field input, .field select, .field textarea { min-height: 44px; }
  textarea { min-height: 7rem; }
</style>
