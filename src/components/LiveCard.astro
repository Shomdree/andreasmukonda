---
import type { LiveItem } from "../lib/types";
import VideoPlayer from "./VideoPlayer.astro";
import { pageI18n } from "../i18n/request";
import { resolveVideo } from "../lib/video-embed";
import { isCatalogVideo } from "../content/video-catalog";

type Props = { live: LiveItem; featured?: boolean };
const { live, featured } = Astro.props;
const { t, locale } = pageI18n(Astro.locals);
const labels = {
  programme: t.catalog.liveScheduled,
  "en-direct": t.catalog.liveNow,
  replay: t.catalog.liveReplay,
};
const resolved = resolveVideo(live.url);
const canPlayHere = Boolean(resolved.embedSrc) || resolved.kind === "file";
const workVideo = isCatalogVideo(live);
const cta = workVideo
  ? t.lives.playVideo
  : live.status === "replay"
    ? t.catalog.watchReplay
    : live.status === "en-direct"
      ? t.catalog.watchLive
      : t.lives.playVideo;
const kicker = workVideo ? t.lives.videosKicker : labels[live.status];
const dateLocale = locale === "en" ? "en-GB" : "fr-FR";
const defaultThumb = "/images/covers/campagne.svg";
const poster = live.thumbnailUrl && live.thumbnailUrl !== defaultThumb ? live.thumbnailUrl : resolved.poster ?? live.thumbnailUrl;
const platform = live.platform || resolved.platform;
---

<article class="live">
  <VideoPlayer
    url={live.url}
    title={live.title}
    poster={poster}
    playLabel={canPlayHere ? cta : t.lives.openPlatform}
    playerTitle={t.catalog.videoPlayer}
    featured={featured}
    eager={featured}
  >
    <p class="kicker">{kicker}{platform ? ` · ${platform}` : ""}</p>
    <h3 class="display">{live.title}</h3>
    {live.description && <p>{live.description}</p>}
    {
      live.scheduledAt && (
        <p class="meta">
          <time datetime={live.scheduledAt}>
            {new Date(live.scheduledAt).toLocaleString(dateLocale, { dateStyle: "medium", timeStyle: "short" })}
          </time>
          {live.duration ? ` · ${live.duration}` : ""}
        </p>
      )
    }
    <p class="actions">
      <a
        class="btn btn-primary"
        href={live.url}
        rel="noopener noreferrer"
        data-video-play
        data-player-title={t.catalog.videoPlayer}
      >
        {canPlayHere ? cta : t.lives.openPlatform}
      </a>
    </p>
  </VideoPlayer>
</article>

<style>
  .live {
    min-width: 0;
  }
  h3 {
    font-size: clamp(1.2rem, 3vw, 1.7rem);
    overflow-wrap: anywhere;
    line-height: 1.15;
    margin: 0.2rem 0 0.4rem;
  }
  p {
    color: var(--fg-soft);
    margin: 0;
  }
  .meta {
    color: var(--mute);
    font-size: 0.9rem;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.4rem;
  }
</style>
