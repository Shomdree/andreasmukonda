---
type Props = { homeHref: string; homeLabel: string; items: { label: string; href: string }[] };
---

<nav class="crumbs" aria-label="Fil d'Ariane">
  <ol>
    <li><a href={Astro.props.homeHref}>{Astro.props.homeLabel}</a></li>
    {
      Astro.props.items.map((item, i) => (
        <li>
          {i === Astro.props.items.length - 1 ? (
            <span aria-current="page">{item.label}</span>
          ) : (
            <a href={item.href}>{item.label}</a>
          )}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.6rem;
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem;
    color: var(--mute);
    font-size: 0.88rem;
  }
  li:not(:last-child)::after {
    content: "/";
    margin-left: 0.6rem;
    opacity: 0.5;
  }
  a {
    color: inherit;
  }
</style>
