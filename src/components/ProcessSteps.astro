---
type Props = { steps: readonly { title: string; text: string }[]; numbered?: boolean };
---

<ol class="steps">
  {
    Astro.props.steps.map((step, i) => (
      <li data-reveal="up" style={`--d:${i * 90}ms`}>
        <p class="kicker">{Astro.props.numbered === false ? "" : String(i + 1).padStart(2, "0")}</p>
        <h3 class="display">{step.title}</h3>
        <p>{step.text}</p>
      </li>
    ))
  }
</ol>

<style>
  .steps {
    display: grid;
    gap: 1rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  li {
    border-top: 1px solid var(--line);
    padding-top: 0.9rem;
    transition-delay: var(--d, 0ms);
  }
  h3 {
    font-size: clamp(1.2rem, 3vw, 1.4rem);
    margin: 0.2rem 0 0.35rem;
  }
  p {
    color: var(--fg-soft);
  }
  @media (min-width: 800px) {
    .steps {
      grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
      gap: 1.2rem;
    }
    li {
      border-top: 0;
      border-left: 1px solid var(--line);
      padding: 0 0 0 1rem;
    }
  }
</style>
